DE_API_URL="https://ex.1580.ru"
DE_REPO_DIR="/opt/digital-examen-computers"
DE_REPO_BRANCH="main"
DE_API_TIMEOUT="10"
DE_DEVICE_NAME=""

DE_USER_GROUP="de-students"
DE_EXTRA_GROUPS=""
DE_USER_SHELL="/bin/bash"
DE_HOME_BASE="/home"
DE_MIN_UID="20000"
DE_MAX_UID="29999"

DE_LOGIN_MIN_LENGTH="3"
DE_LOGIN_MAX_LENGTH="31"

DE_ALLOW_ROLES="1"

DE_WIPE_ON_LOGOUT="1"

DE_PROTECTED_USERS="root"

DE_LOG_FILE="/var/log/digital-examen-computers.log"

DE_SCHOOL_PROXY_HOST="ex.1580.ru"
DE_SCHOOL_PROXY_FALLBACK="sch-1580-2-1580.obr.mos.ru"
DE_SCHOOL_PROXY_PORT="3128"
DE_PROXY_SECRET_FILE="/etc/digital-examen/proxy.secret"
DE_SCREEN_SECRET_FILE="/etc/digital-examen/screen.secret"
DE_VAULT_SECRET_FILE="/etc/digital-examen/vault.secret"

DE_NETNS="de-student"
DE_NETNS_HOST_IP="10.77.0.1"
DE_NETNS_GUEST_IP="10.77.0.2"
DE_NETNS_PREFIX="30"
DE_NETNS_HOST_IF="de-host"
DE_NETNS_GUEST_IF="de-net"
DE_RELAY_PORT="3128"

DE_SCREEN_URL="https://ex.1580.ru/screens"
DE_SCREEN_WIDTH="1280"
DE_SCREEN_HEIGHT="720"
DE_SCREEN_STORE_WIDTH="1024"
DE_SCREEN_STORE_HEIGHT="576"
DE_SCREEN_TILE="16"
DE_SCREEN_INTERVAL="2"
DE_SCREEN_INTERVAL_MIN="1"
DE_SCREEN_INTERVAL_MAX="30"
DE_SCREEN_BUDGET_KBITS="0"
DE_SCREEN_QUALITY="50"
DE_SCREEN_THUMB_WIDTH="320"
DE_SCREEN_THUMB_EVERY="4"
DE_SCREEN_MODE_FILE="/run/digital-examen/screen-mode"
DE_SCREEN_KEYFRAME_EVERY="120"
DE_SCREEN_KEYFRAME_SHARE="40"
DE_SCREEN_WORK_DIR="/run/digital-examen/screen"
DE_SCREEN_QUEUE_LIMIT_KB="20480"
DE_HOME_TMPFS_SIZE="2G"
DE_BOX_BASE="/var/lib/digital-examen/box-base"
DE_BOX_SHELL="/bin/bash"
DE_AGENT_WAIT="25"
DE_SCREEN_COLORS="8"
DE_AGENT_ALLOW_EXEC="1"
DE_AGENT_EXEC_TIMEOUT="30"
DE_AGENT_EXEC_SHELL="/bin/sh"

DE_SCREEN_CA="/etc/digital-examen/school-ca.pem"
DE_COMMAND_SECRET_FILE="/etc/digital-examen/command.secret"
DE_SCREEN_LIVE_INTERVAL="1"
DE_SCREEN_WATCH_INTERVAL="2"
DE_SCREEN_LESSONS_ONLY="0"

DE_COMPUTER_ID=""
DE_COMPUTER_CORPUS=""
DE_COMPUTER_ROOM=""
DE_COMPUTER_NUMBER=""

DE_KEY_FILE="de-key.txt"
DE_KEY_PUBLIC_FILE="/etc/digital-examen/key-public.pem"
DE_KEY_SUDO_GROUP="de-keyholders"
DE_KEY_POLL="5"

DE_TRAFFIC_QUEUE="/run/digital-examen/traffic-queue.jsonl"
DE_TRAFFIC_SOCKET="/run/digital-examen/traffic.sock"
DE_TRAFFIC_SEEN_SECONDS="300"
DE_FILTER="0"
DE_WATCH="1"
DE_CA_DIR="/var/lib/digital-examen/ca"
DE_CA_YEARS="5"
DE_NO_OPEN_FILE="/etc/digital-examen/no-open.txt"

DE_POLICY_FILE="/run/digital-examen/policy.json"
DE_POLICY_MODULE="/usr/local/sbin/de-policy"
DE_TRAFFIC_FLUSH="60"
DE_TRAFFIC_BUDGET_GB="100"
DE_TRAFFIC_MAX_PER_FLUSH="2000"

DE_SECURE_DISK="1"
DE_SECURE_IMAGE="/var/lib/digital-examen/secure.img"
DE_SECURE_MOUNT="/var/lib/digital-examen/secure"
DE_SECURE_NAME="de-secure"
DE_SECURE_SIZE_GB="8"
DE_SECURE_KEY_FILE="/etc/digital-examen/secure.key"
DE_SECURE_STATE_FILE="/var/lib/digital-examen/secure.json"

DE_OFFLINE_LOGIN="1"
DE_VAULT_DIR="/var/lib/digital-examen/vault"
DE_VAULT_MAX_AGE_DAYS="30"
DE_VAULT_MAX_TRIES="10"
DE_VAULT_LOCK_MINUTES="30"

DE_SCREEN_ALWAYS="1"
DE_SCREEN_GREETER_LOGIN="_greeter"
DE_SCREEN_QUEUE_DIR="/var/lib/digital-examen/screen-queue"
DE_SCREEN_MIN_FREE_MB="512"
DE_SCREEN_QUEUE_SEND="3"

DE_AI_URL="https://ex.1580.ru/api/computers/device/ai"
DE_AI_TIMEOUT="2"

DE_STATS_INTERVAL="5"
DE_HEARTBEAT_INTERVAL="30"
