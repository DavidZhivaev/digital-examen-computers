DE_API_URL="https://examen.1580.ru"
DE_API_TIMEOUT="10"
DE_DEVICE_NAME=""

DE_USER_GROUP="de-students"
DE_EXTRA_GROUPS=""
DE_USER_SHELL="/bin/bash"
DE_HOME_BASE="/home"
DE_MIN_UID="20000"
DE_MAX_UID="29999"

DE_LOGIN_MIN_LENGTH="3"
DE_LOGIN_MAX_LENGTH="31"

DE_ALLOW_ROLES="1"

DE_WIPE_ON_LOGOUT="1"

DE_PROTECTED_USERS="root"

DE_LOG_FILE="/var/log/digital-examen-computers.log"

DE_SCHOOL_PROXY_HOST="sch-1580-2-1580.obr.mos.ru"
DE_SCHOOL_PROXY_FALLBACK="10.171.219.221"
DE_SCHOOL_PROXY_PORT="3128"
DE_PROXY_SECRET_FILE="/etc/digital-examen/proxy.secret"

DE_NETNS="de-student"
DE_NETNS_HOST_IP="10.77.0.1"
DE_NETNS_GUEST_IP="10.77.0.2"
DE_NETNS_PREFIX="30"
DE_NETNS_HOST_IF="de-host"
DE_NETNS_GUEST_IF="de-net"
DE_RELAY_PORT="3128"

DE_SCREEN_URL="https://sch-1580-2-1580.obr.mos.ru/screens"
DE_SCREEN_WIDTH="1024"
DE_SCREEN_HEIGHT="576"
DE_SCREEN_TILE="16"
DE_SCREEN_INTERVAL="8"
DE_SCREEN_INTERVAL_MIN="2"
DE_SCREEN_INTERVAL_MAX="30"
DE_SCREEN_BUDGET_KBITS="8"
DE_SCREEN_QUALITY="50"
DE_SCREEN_THUMB_WIDTH="320"
DE_SCREEN_THUMB_EVERY="4"
DE_SCREEN_MODE_FILE="/run/digital-examen/screen-mode"
DE_SCREEN_KEYFRAME_EVERY="120"
DE_SCREEN_KEYFRAME_SHARE="40"
DE_SCREEN_WORK_DIR="/run/digital-examen/screen"
DE_SCREEN_QUEUE_LIMIT_KB="20480"
DE_HOME_TMPFS_SIZE="2G"
DE_BOX_BASE="/var/lib/digital-examen/box-base"
DE_BOX_SHELL="/bin/bash"
DE_AGENT_WAIT="25"
DE_SCREEN_COLORS="8"
DE_AGENT_ALLOW_EXEC="1"
DE_AGENT_EXEC_TIMEOUT="30"
DE_AGENT_EXEC_SHELL="/bin/sh"

DE_SCREEN_CA="/etc/digital-examen/school-ca.pem"
DE_COMMAND_SECRET_FILE="/etc/digital-examen/command.secret"
