Defaults!/usr/local/sbin/de-enter-net env_keep += "DISPLAY XAUTHORITY LANG LC_ALL XDG_SEAT XDG_VTNR XDG_SESSION_ID XDG_SESSION_TYPE XDG_SESSION_CLASS XDG_CURRENT_DESKTOP DBUS_SESSION_BUS_ADDRESS"
Defaults!/usr/local/sbin/de-box env_keep += "DISPLAY XAUTHORITY LANG LC_ALL http_proxy https_proxy"
%de-students ALL=(root) NOPASSWD: /usr/local/sbin/de-enter-net
%de-students ALL=(root) NOPASSWD: /usr/local/sbin/de-box
