#!/bin/sh
set -eu

requirements=$1
runtime=/opt/de-inspect
python=/usr/bin/python3.8

if ! getent group de-inspect >/dev/null; then
    groupadd --system de-inspect
fi

if ! cmp -s "$requirements" "$runtime/requirements.installed" || [ ! -x "$runtime/bin/mitmdump" ]; then
    "$python" -m venv "$runtime"
    "$runtime/bin/python" -m pip --isolated --disable-pip-version-check install \
        --index-url https://pypi.org/simple -r "$requirements"
    "$runtime/bin/python" -m pip check
    "$runtime/bin/mitmdump" --version
    install -m 0644 "$requirements" "$runtime/requirements.installed"
fi
