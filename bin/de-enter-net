#!/bin/sh

CONFIG_FILE=/etc/digital-examen/computers.conf
[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"

NS="${DE_NETNS:-de-student}"
GROUP="${DE_USER_GROUP:-de-students}"
SESSION="${DE_SESSION_COMMAND:-/usr/bin/startplasma-x11}"
LOG="${DE_LOG_FILE:-/var/log/digital-examen-computers.log}"

write_log() {
    echo "`date '+%Y-%m-%d %H:%M:%S'` de-enter-net $1" >> "$LOG"
}

[ -z "$SUDO_UID" ] && exit 1
[ -z "$SUDO_GID" ] && exit 1

NAME=`getent passwd "$SUDO_UID" | cut -d: -f1`
[ -z "$NAME" ] && exit 1

if [ "`id -gn \"$NAME\"`" != "$GROUP" ]; then
    write_log "refused: $NAME is not in $GROUP"
    exit 1
fi

if ! ip netns list | grep -qx "$NS"; then
    write_log "namespace $NS is missing, session refused"
    exit 1
fi

mkdir -p /run/digital-examen
chmod 0755 /run/digital-examen
echo "$NAME" > /run/digital-examen/current-login
chmod 0644 /run/digital-examen/current-login

write_log "session for $NAME starts inside $NS"

exec ip netns exec "$NS" setpriv --reuid="$SUDO_UID" --regid="$SUDO_GID" --init-groups "$SESSION"
