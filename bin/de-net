#!/usr/bin/python3

from concurrent.futures import ThreadPoolExecutor
import grp
import http.client
import ipaddress
import json
import os
import pwd
import socket
import socketserver
import struct
import subprocess
import sys
from urllib.parse import urlsplit
import threading
import time
import urllib.request

sys.path.insert(0, "/usr/local/lib/digital-examen")

import de_ansible_network
import de_common
import de_patterns
import de_inspection
import de_upstream

PROXY_PORT = 3129
DNS_PORT = 5399
TABLE = "de_agent"
RELAY_MARK = 0x44450000
SCHOOL_PROXY_MARK = 0x44450001
RELAY_RULE = ["pref", "8999", "fwmark", hex(RELAY_MARK) + "/0xffffffff", "lookup", "main"]
POLICY_FILE = os.path.join(de_common.STATE_DIR, "policy.json")
TRAFFIC_SOCKET = os.path.join(de_common.RUN_DIR, "traffic.sock")
AI_URL = de_common.setting("DE_API_URL", "").rstrip("/") + "/api/computers/device/ai"
PEOPLE_EVERY = 10

TOLD = {}
AI_CACHE = {}
AI_PENDING = set()
AI_WORKERS = ThreadPoolExecutor(max_workers=2)
AI_HOSTS = de_patterns.read_list(os.path.join(
    de_common.setting("DE_REPO_DIR", "/opt/digital-examen-computers"),
    "proxy", "policy", "ai-domains.txt",
))
POLICY = {"stamp": 0, "data": {}}
LOCK = threading.Lock()
PEOPLE = set()
EXPECTED_RULES = None

def blocked_response():
    body = de_inspection.block_page()
    return (b"HTTP/1.1 403 Forbidden\r\nContent-Type: text/html; charset=utf-8\r\n"
            b"Cache-Control: no-store\r\nContent-Security-Policy: " + de_inspection.BLOCK_PAGE_CSP.encode("ascii")
            + b"\r\nContent-Length: " + str(len(body)).encode()
            + b"\r\nConnection: close\r\n\r\n" + body)


def log(message):
    de_common.log("de-net", message)


def nft(script):
    process = subprocess.run(["nft", "-f", "-"], input=script.encode(),
                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    if process.returncode != 0:
        log("nft: " + process.stdout.decode("utf-8", "replace").strip()[:300])
    return process.returncode == 0


def installed_rules():
    result = subprocess.run(["nft", "list", "table", "inet", TABLE],
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    return result.stdout if result.returncode == 0 else None


def rules_up():
    global EXPECTED_RULES
    current = installed_rules()
    prefix = "delete table inet %s\n" % TABLE if current is not None else ""
    users = "elements = { %s }" % ", ".join(map(str, sorted(PEOPLE))) if PEOPLE else ""
    ok = nft(prefix + """
table inet %(table)s {
    set people {
        type uid
        %(users)s
    }
    chain nat_out {
        type nat hook output priority -100; policy accept;
        meta skuid @people ip daddr != 127.0.0.0/8 tcp dport { 80, 443 } redirect to :%(proxy)d
        meta skuid @people ip6 daddr != ::1 tcp dport { 80, 443 } redirect to :%(proxy)d
        meta skuid @people meta nfproto ipv4 udp dport 53 redirect to :%(dns)d
        meta skuid @people meta nfproto ipv6 udp dport 53 redirect to :%(dns)d
    }
    chain filter_out {
        type filter hook output priority 0; policy accept;
        meta skuid != @people accept
        ip daddr 127.0.0.1 tcp dport %(proxy)d accept
        ip6 daddr ::1 tcp dport %(proxy)d accept
        ip daddr 127.0.0.1 udp dport %(dns)d accept
        ip6 daddr ::1 udp dport %(dns)d accept
        tcp dport { %(inspect)d, %(origin)d } reject with tcp reset
        oifname "lo" accept
        meta l4proto tcp reject with tcp reset
        reject
    }
}
""" % {"table": TABLE, "proxy": PROXY_PORT, "dns": DNS_PORT,
        "inspect": de_inspection.LISTEN_PORT, "origin": de_inspection.ORIGIN_PORT, "users": users})
    EXPECTED_RULES = installed_rules() if ok else None
    return ok


def relay_exception(enable):
    try:
        inspection_gid = grp.getgrnam("de-inspect").gr_gid
    except KeyError:
        inspection_gid = None
    for tool, loopback in (("iptables", "127.0.0.1"), ("ip6tables", "::1")):
        legacy_proxy = ["-m", "owner", "--uid-owner", "0", "-m", "mark", "--mark",
                        hex(SCHOOL_PROXY_MARK), "-p", "tcp", "--dport", "3128"]
        rules = [
            ["-m", "owner", "--uid-owner", "0", "-m", "mark", "--mark",
             hex(RELAY_MARK), "-p", "tcp", "-m", "multiport", "--dports", "80,443"],
            ["-d", loopback, "-p", "tcp", "--dport", str(PROXY_PORT)],
            ["-d", loopback, "-p", "udp", "--dport", str(DNS_PORT)],
        ]
        if inspection_gid is not None:
            rules.append(["-m", "owner", "--gid-owner", str(inspection_gid), "-p", "tcp", "--dport", "443"])
        prefix = [tool, "-w", "2"]
        options = {"stdout": subprocess.DEVNULL, "stderr": subprocess.DEVNULL}
        try:
            suffix = ["-m", "comment", "--comment", "Digital Examen web relay", "-j", "ACCEPT"]
            subprocess.call(prefix + ["-D", "OUTPUT"] + legacy_proxy + suffix, **options)
            for match in rules:
                match += ["-m", "comment", "--comment", "Digital Examen web relay", "-j", "ACCEPT"]
                present = subprocess.call(prefix + ["-C", "OUTPUT"] + match, **options) == 0
                if enable and not present:
                    subprocess.call(prefix + ["-I", "OUTPUT", "1"] + match, **options)
                elif not enable and present:
                    subprocess.call(prefix + ["-D", "OUTPUT"] + match, **options)
        except FileNotFoundError:
            continue


def relay_route(enable):
    try:
        return subprocess.call(["ip", "-4", "rule", "add" if enable else "del", *RELAY_RULE],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0
    except FileNotFoundError:
        return False


def rules_down():
    relay_route(False)
    subprocess.call(["nft", "delete", "table", "inet", TABLE],
                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def update_people():
    global PEOPLE, EXPECTED_RULES
    current = {entry.pw_uid for entry in de_common.people()}
    if current == PEOPLE:
        return True
    script = "flush set inet %s people\n" % TABLE
    if current:
        script += "add element inet %s people { %s }\n" % (TABLE, ", ".join(map(str, sorted(current))))
    if not nft(script):
        return False
    PEOPLE = current
    EXPECTED_RULES = installed_rules()
    log("ограничения действуют для UID: " + (", ".join(map(str, sorted(current))) or "никого"))
    return True


def people_loop():
    while True:
        time.sleep(PEOPLE_EVERY)
        try:
            if EXPECTED_RULES is None or installed_rules() != EXPECTED_RULES:
                if rules_up():
                    log("правила сети восстановлены")
            update_people()
        except Exception as error:
            log("список людей не собран: %s" % error)


def reconcile_loop():
    next_config_check = 0
    while True:
        relay_exception(True)
        now = time.monotonic()
        if now >= next_config_check:
            de_ansible_network.reconcile()
            next_config_check = now + 60
        time.sleep(15)


def policy():
    try:
        stamp = os.path.getmtime(POLICY_FILE)
    except OSError:
        return POLICY["data"]
    if stamp != POLICY["stamp"]:
        try:
            candidate = json.loads(open(POLICY_FILE).read())
            if isinstance(candidate, dict):
                POLICY["data"] = candidate
        except (IOError, ValueError):
            return POLICY["data"]
        POLICY["stamp"] = stamp
    return POLICY["data"]


def classify_host(host):
    answer, ttl = False, 30
    try:
        request = urllib.request.Request(AI_URL, data=json.dumps({"host": host}).encode())
        request.add_header("Content-Type", "application/json")
        request.add_header("X-De-Computer", de_common.computer())
        request.add_header("X-De-Secret", de_common.secret("proxy"))
        with urllib.request.urlopen(request, timeout=2) as response:
            answer = bool(json.load(response).get("ai"))
            ttl = 3600
    except (OSError, ValueError):
        pass
    finally:
        with LOCK:
            AI_PENDING.discard(host)
            if len(AI_CACHE) >= 2048 and host not in AI_CACHE:
                AI_CACHE.pop(next(iter(AI_CACHE)))
            AI_CACHE[host] = (answer, time.monotonic() + ttl)


def ask_ai(host):
    if host == "sdo.1580.ru" or host.endswith(".sdo.1580.ru"):
        return False
    with LOCK:
        known = AI_CACHE.get(host)
        if known and time.monotonic() < known[1]:
            return known[0]
        if host not in AI_PENDING and len(AI_PENDING) < 16:
            AI_PENDING.add(host)
            AI_WORKERS.submit(classify_host, host)
        return bool(known and known[0])


def decide(host):
    groups = sorted(policy().get("groups", []), key=lambda item: -int(item.get("priority", 50)))
    for group in groups:
        if de_patterns.any_match(group.get("always_allow"), host):
            return "pass", group.get("name") or "Всегда разрешено"
    for group in groups:
        name = group.get("name", "")
        if group.get("ai_auto") and de_patterns.any_match(AI_HOSTS, host):
            return "ai_block", name
        if group.get("principle") == "allow":
            return "block", name
        if de_patterns.any_match(group.get("denied"), host):
            return "block", name
        if group.get("ai_auto") and ask_ai(host):
            return "ai_block", name
    return "pass", ""


def note(kind, value, login):
    record = {"kind": kind, "value": value, "at": int(time.time()), "login": login}
    try:
        client = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        client.sendto(json.dumps(record).encode(), TRAFFIC_SOCKET)
        client.close()
    except OSError:
        pass


def note_block(host, login, group):
    key = login + "|" + host
    now = time.time()
    with LOCK:
        if now - TOLD.get(key, 0) < 60:
            return
        TOLD[key] = now
    note("block", host + " - " + group if group else host, login)


def owner_of(address, permitted=None, destination=None):
    ip, port = address[:2]
    family = socket.AF_INET6 if ":" in ip else socket.AF_INET
    packed = socket.inet_pton(family, ip)
    hex_ip = "".join("%08X" % word for word in struct.unpack("=%dI" % (len(packed) // 4), packed))
    wanted = "%s:%04X" % (hex_ip, port)
    path = "/proc/net/tcp6" if family == socket.AF_INET6 else "/proc/net/tcp"
    try:
        with open(path) as entries:
            for line in entries:
                fields = line.split()
                if len(fields) < 8 or fields[1] != wanted or (destination and fields[2] != destination):
                    continue
                try:
                    uid = int(fields[7])
                    if uid in (PEOPLE if permitted is None else permitted):
                        return pwd.getpwuid(uid).pw_name
                    return ""
                except (KeyError, ValueError):
                    return fields[7]
    except OSError:
        pass
    return ""


def original_target(client):
    if client.family == socket.AF_INET6:
        data = client.getsockopt(socket.IPPROTO_IPV6, 80, 28)
        ip = socket.inet_ntop(socket.AF_INET6, data[8:24])
    else:
        data = client.getsockopt(socket.SOL_IP, 80, 16)
        ip = socket.inet_ntop(socket.AF_INET, data[4:8])
    port = struct.unpack("!H", data[2:4])[0]
    return ip, port


def read_hello(client):
    data = b""
    deadline = time.time() + 5
    while time.time() < deadline:
        try:
            chunk = client.recv(16384)
        except socket.timeout:
            break
        if not chunk:
            break
        data += chunk
        if data[:1] == b"\x16":
            if len(data) >= 5 and len(data) >= 5 + struct.unpack("!H", data[3:5])[0]:
                break
        elif b"\r\n\r\n" in data:
            break
        if len(data) > 65536:
            break
    return data


def sni_of(data):
    try:
        if data[0] != 0x16 or data[5] != 0x01:
            return ""
        place = 9 + 2 + 32
        place += 1 + data[place]
        place += 2 + struct.unpack("!H", data[place:place + 2])[0]
        place += 1 + data[place]
        end = place + 2 + struct.unpack("!H", data[place:place + 2])[0]
        place += 2
        while place + 4 <= end:
            kind, size = struct.unpack("!HH", data[place:place + 4])
            place += 4
            if kind == 0:
                length = struct.unpack("!H", data[place + 3:place + 5])[0]
                return data[place + 5:place + 5 + length].decode("ascii", "replace").lower()
            place += size
    except (IndexError, struct.error):
        return ""
    return ""


def host_of(data):
    try:
        head = data.split(b"\r\n\r\n", 1)[0].decode("latin-1")
    except UnicodeDecodeError:
        return ""
    for line in head.split("\r\n")[1:]:
        if line.lower().startswith("host:"):
            value = line.split(":", 1)[1].strip().lower()
            if value.startswith("["):
                return value[1:].split("]", 1)[0]
            return value.split(":", 1)[0]
    return ""


def pipe(source, target):
    try:
        while True:
            chunk = source.recv(65536)
            if not chunk:
                break
            target.sendall(chunk)
    except OSError:
        pass
    try:
        target.shutdown(socket.SHUT_WR)
    except OSError:
        pass


def bridge(client, upstream):
    client.settimeout(None)
    upstream.settimeout(None)
    other = threading.Thread(target=pipe, args=(client, upstream), daemon=True)
    other.start()
    pipe(upstream, client)
    other.join(timeout=5)


def proxy_target(data):
    request, separator, remainder = data.partition(b"\r\n")
    method, target, version = request.decode("ascii").split()
    tunnel = method == "CONNECT"
    address = urlsplit("//" + target if tunnel else target)
    if not tunnel and address.scheme != "http":
        return None
    port = address.port or (443 if tunnel else 80)
    if port != (443 if tunnel else 80) or not address.hostname or address.username or address.password:
        raise ValueError("неподдерживаемый адрес прокси")
    payload = remainder.partition(b"\r\n\r\n")[2]
    if not tunnel:
        lines = remainder.split(b"\r\n")
        for index, line in enumerate(lines):
            if not line:
                headers = [item for item in lines[:index] if not item.lower().startswith(b"proxy-")]
                path = (address.path or "/") + ("?" + address.query if address.query else "")
                payload = (f"{method} {path} {version}".encode("ascii") + separator
                           + b"\r\n".join(headers + lines[index:]))
                break
    return address.hostname, port, payload, tunnel


def connect_web(host, port, public_only, timeout=10):
    for family, kind, protocol, _, address in socket.getaddrinfo(host, port, type=socket.SOCK_STREAM):
        if public_only and not ipaddress.ip_address(address[0]).is_global:
            continue
        upstream = socket.socket(family, kind, protocol)
        try:
            upstream.settimeout(timeout)
            upstream.setsockopt(socket.SOL_SOCKET, socket.SO_MARK, RELAY_MARK)
            upstream.connect(address)
            return upstream
        except OSError:
            upstream.close()
    raise OSError("сайт недоступен")


def inspect_http(client, upstream, data, host, port):
    payload, remaining = de_upstream.http_request(data, host, port)
    if remaining + len(payload) > de_inspection.MAX_BODY:
        raise ValueError("слишком большой запрос")
    head, pending = payload.split(b"\r\n\r\n", 1)
    body = bytearray(pending)
    while remaining:
        chunk = client.recv(remaining)
        if not chunk:
            raise OSError("неполный запрос HTTP")
        body.extend(chunk)
        remaining -= len(chunk)
    rules = de_inspection.groups.get()
    first, *headers = head.split(b"\r\n")
    method, target, version = first.split()
    url = target.decode("ascii")
    scan = not de_inspection.url_allowed(host, url, rules) and bool(de_inspection.content_terms(rules))
    request_fields = {key.lower(): value.strip() for key, _, value in
                      (line.partition(b":") for line in headers)}
    checked_body = de_inspection.text_prefix(
        body, request_fields.get(b"content-encoding", b"identity").decode("latin-1").lower(),
        de_inspection.body_scan_limit(request_fields.get(b"content-type", b"").decode("latin-1"), len(body)),
    ) if scan else b""
    if de_inspection.url_blocked(host, url, rules) or (scan and de_inspection.matches_content([head, checked_body], rules)):
        client.sendall(blocked_response())
        return True
    path = target[len(b"http://" + de_upstream.authority(host, port).encode("ascii")):]
    excluded_request = {b"upgrade", b"expect"}
    if scan:
        excluded_request.add(b"accept-encoding")
    headers = [line for line in headers if line.split(b":", 1)[0].lower() not in excluded_request]
    if scan:
        headers.append(b"Accept-Encoding: identity")
    request = b"\r\n".join([b" ".join((method, path, version)), *headers, b"", body])
    upstream.sendall(request)
    with http.client.HTTPResponse(upstream, method=method.decode("ascii")) as reply:
        reply.begin()
        if reply.status == 101:
            raise ValueError("смена протокола не поддерживается")
        fields = reply.getheaders()
        status = "HTTP/1.1 %d " % reply.status
        prefix = b""
        if scan:
            response_headers = "\r\n".join("%s: %s" % field for field in fields)
            limit = de_inspection.body_scan_limit(reply.headers.get("Content-Type", ""),
                                                  reply.headers.get("Content-Length"))
            encoding = reply.headers.get("Content-Encoding", "identity").lower()
            if limit:
                prefix = reply.read(limit)
            if de_inspection.matches_content(
                    [head, checked_body, (status + "\r\n" + response_headers).encode("latin-1"),
                     de_inspection.text_prefix(prefix, encoding, limit)], rules):
                client.sendall(blocked_response())
                return True
        excluded = {"connection", "transfer-encoding", "trailer", "upgrade", "keep-alive"}
        excluded.update(name.strip().lower() for name in reply.headers.get("Connection", "").split(","))
        if method != b"HEAD":
            excluded.add("content-length")
        headers = [
            "%s: %s" % (name, value)
            for name, value in fields
            if name.lower() not in excluded
            and de_upstream.TOKEN.fullmatch(name.encode("latin-1"))
            and all(ord(char) >= 32 or char == "\t" for char in value)
        ]
        client.sendall("\r\n".join([status, *headers, "Connection: close", "", ""]).encode("latin-1"))
        client.sendall(prefix)
        while True:
            chunk = reply.read1(65536)
            if not chunk:
                break
            client.sendall(chunk)
    return False


class Handler(socketserver.BaseRequestHandler):

    def handle(self):
        client = self.request
        login = owner_of(self.client_address)
        if not login:
            return
        client.settimeout(5)
        data = read_hello(client)
        if not data:
            return

        secure = data[:1] == b"\x16"
        try:
            proxy = None if secure else proxy_target(data)
        except (UnicodeError, ValueError):
            return
        if proxy:
            host, port, data, tunnel = proxy
            ip = host
        else:
            try:
                ip, port = original_target(client)
            except OSError:
                return
            host = sni_of(data) if secure else host_of(data)
            tunnel = False
        if not host:
            host = ip
        try:
            de_upstream.authority(host, port)
        except ValueError:
            return

        verdict, group = decide(host)
        inspect_tls = port == 443 and de_inspection.host_name(host) in de_inspection.hosts.get()
        if verdict != "pass" and not inspect_tls and (
                verdict == "ai_block" or port != 80 or group not in {rule.get("name") for rule in de_inspection.groups.get()
                                            if rule.get("url_allow")}):
            note_block(host, login, group)
            if not secure:
                try:
                    client.sendall(blocked_response())
                except OSError:
                    pass
            return

        if tunnel:
            try:
                client.sendall(b"HTTP/1.1 200 Connection Established\r\n\r\n")
                data = data or read_hello(client)
            except OSError:
                return
            if sni_of(data).rstrip(".") != host.rstrip("."):
                return
        try:
            if port == 443 and inspect_tls:
                upstream = socket.create_connection(("127.0.0.1", de_inspection.LISTEN_PORT), timeout=3)
                upstream.settimeout(15)
                try:
                    decision = b"X-Digital-Examen-Block: ai" if verdict == "ai_block" else b""
                    if de_upstream.tunnel(upstream, host, port, decision) != 200:
                        raise OSError("локальный анализ отклонил домен")
                except OSError:
                    upstream.close()
                    raise
            else:
                upstream = connect_web(ip, port, proxy is not None)
        except OSError:
            return
        if port == 80:
            try:
                with upstream:
                    if inspect_http(client, upstream, data, host, port):
                        note_block(host, login, "Фильтр содержимого")
                    else:
                        note("site", host, login)
            except (OSError, ValueError, http.client.HTTPException):
                pass
            return
        with upstream:
            try:
                if data:
                    upstream.sendall(data)
                note("site", de_inspection.host_name(host), login)
                bridge(client, upstream)
            except OSError:
                return


class InspectionOrigin(socketserver.BaseRequestHandler):
    def handle(self):
        destination = "0100007F:%04X" % de_inspection.ORIGIN_PORT
        if not owner_of(self.client_address, {0}, destination):
            return
        client = self.request
        client.settimeout(5)
        try:
            target = proxy_target(read_hello(client))
            if not target or not target[3] or target[2]:
                return
        except (UnicodeError, ValueError, OSError):
            return
        host, port, _, _ = target
        try:
            with connect_web(host, port, False, timeout=4) as upstream:
                client.sendall(b"HTTP/1.1 200 Connection Established\r\n\r\n")
                bridge(client, upstream)
        except OSError:
            try:
                client.sendall(b"HTTP/1.1 502 Bad Gateway\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
            except OSError:
                pass


class Server(socketserver.ThreadingTCPServer):
    request_queue_size = 128
    allow_reuse_address = True
    daemon_threads = True


class IPv6Server(Server):
    address_family = socket.AF_INET6

    def server_bind(self):
        self.socket.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
        super().server_bind()


def upstream_dns():
    try:
        for line in open("/etc/resolv.conf"):
            parts = line.split()
            if len(parts) >= 2 and parts[0] == "nameserver":
                try:
                    return ipaddress.ip_address(parts[1])
                except ValueError:
                    continue
    except IOError:
        pass
    return ipaddress.ip_address("127.0.0.53")


def question_end(packet):
    place = 12
    while place < len(packet):
        size = packet[place]
        if size == 0:
            break
        place += 1 + size
    return place + 5


def question_type(packet):
    end = question_end(packet)
    if end > len(packet):
        return 0
    return struct.unpack("!H", packet[end - 4:end - 2])[0]


def empty_answer(packet):
    flags = struct.unpack("!H", packet[2:4])[0]
    flags = 0x8000 | (flags & 0x7900) | 0x0080
    return packet[:2] + struct.pack("!HHHHH", flags, 1, 0, 0, 0) + packet[12:question_end(packet)]


def answer_dns(server, packet, sender):
    if len(packet) < 12:
        return
    if question_type(packet) in (64, 65):
        server.sendto(empty_answer(packet), sender)
        return
    upstream = upstream_dns()
    family = socket.AF_INET6 if upstream.version == 6 else socket.AF_INET
    outside = socket.socket(family, socket.SOCK_DGRAM)
    outside.settimeout(4)
    try:
        outside.sendto(packet, (str(upstream), 53))
        reply = outside.recv(65535)
        server.sendto(reply, sender)
    except OSError:
        pass
    finally:
        outside.close()


def dns_listener(family, host):
    server = socket.socket(family, socket.SOCK_DGRAM)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    if family == socket.AF_INET6:
        server.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
    server.bind((host, DNS_PORT))
    return server


def dns_loop(server):
    while True:
        try:
            packet, sender = server.recvfrom(65535)
        except OSError:
            continue
        threading.Thread(target=answer_dns, args=(server, packet, sender), daemon=True).start()


def main():
    if os.geteuid() != 0:
        sys.stderr.write("Запускать от root.\n")
        return 1
    if sys.argv[1:] == ["down"]:
        rules_down()
        relay_exception(False)
        return 0

    server = Server(("127.0.0.1", PROXY_PORT), Handler)
    origin = Server(("127.0.0.1", de_inspection.ORIGIN_PORT), InspectionOrigin)
    ipv4_dns = dns_listener(socket.AF_INET, "127.0.0.1")
    threading.Thread(target=dns_loop, args=(ipv4_dns,), daemon=True).start()
    try:
        ipv6 = IPv6Server(("::1", PROXY_PORT), Handler)
        ipv6_dns = dns_listener(socket.AF_INET6, "::1")
    except OSError as error:
        log("IPv6 недоступен: %s" % error)
    else:
        threading.Thread(target=ipv6.serve_forever, daemon=True).start()
        threading.Thread(target=dns_loop, args=(ipv6_dns,), daemon=True).start()
    relay_exception(True)
    if not rules_up() or not update_people():
        log("правила сети не поставились")
        return 1
    if not relay_route(True):
        log("не удалось настроить прямой маршрут веб-реле")
    threading.Thread(target=origin.serve_forever, daemon=True).start()
    threading.Thread(target=people_loop, daemon=True).start()
    threading.Thread(target=reconcile_loop, daemon=True).start()
    notification = os.environ.get("NOTIFY_SOCKET")
    if notification:
        if notification.startswith("@"):
            notification = "\0" + notification[1:]
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as systemd:
            systemd.sendto(b"READY=1", notification)
    log("ограничения сети запущены")
    try:
        server.serve_forever()
    finally:
        rules_down()
        relay_exception(False)
    return 0


if __name__ == "__main__":
    sys.exit(main())
