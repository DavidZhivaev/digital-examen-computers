#!/bin/sh

LINE="$1"
[ -n "$LINE" ] || exit 0

exec /usr/bin/python3 - "$LINE" <<'PY'
import json
import os
import pwd
import socket
import sys
import time

line = sys.argv[1].strip()[:255]
if not line:
    sys.exit(0)

record = {
    "kind": "command",
    "value": line,
    "at": int(time.time()),
    "login": pwd.getpwuid(os.getuid()).pw_name,
}

try:
    client = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    client.sendto(json.dumps(record).encode(), "/run/digital-examen/traffic.sock")
    client.close()
except OSError:
    pass
PY
