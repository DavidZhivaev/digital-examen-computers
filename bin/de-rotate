#!/usr/bin/python3

import sys

sys.path.insert(0, "/usr/local/lib/digital-examen")

import de_common


def main():
    api = de_common.setting("DE_API_URL")
    computer = de_common.computer()
    if not api or not computer:
        return 0

    try:
        answer = de_common.send_json(api.rstrip("/") + "/api/computers/device/rotate",
                                     {"computer": computer}, "proxy", 30)
        secrets = {kind: answer[kind + "_secret"] for kind in ("command", "screen", "proxy")}
        if not all(isinstance(value, str) and value for value in secrets.values()):
            raise ValueError("неполный набор секретов")
        for kind, value in secrets.items():
            de_common.write_file("/etc/digital-examen/%s.secret" % kind, value + "\n", 0o600)
    except (OSError, ValueError, KeyError) as error:
        de_common.log("de-rotate", str(error))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
