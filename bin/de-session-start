#!/bin/sh

CONFIG_FILE=/etc/digital-examen/computers.conf
[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"

GROUP="${DE_USER_GROUP:-de-students}"
SESSION="${DE_SESSION_COMMAND:-/usr/bin/startplasma-x11}"

if [ "`id -gn`" != "$GROUP" ]; then
    exec "$SESSION"
fi

MARK="/run/digital-examen/informatics-`id -un`"
INFORMATICS=""
[ -f "$MARK" ] && INFORMATICS=`cat "$MARK"`

if [ "$INFORMATICS" = "admin" ]; then
    exec "$SESSION"
fi

exec sudo -E -n /usr/local/sbin/de-enter-net
