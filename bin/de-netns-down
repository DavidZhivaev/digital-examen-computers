#!/bin/sh

CONFIG_FILE=/etc/digital-examen/computers.conf
[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"

NS="${DE_NETNS:-de-student}"
HOST_IF="${DE_NETNS_HOST_IF:-de-host}"

nft delete table inet de_box 2>/dev/null
ip netns list | grep -qx "$NS" && ip netns delete "$NS"
ip link show "$HOST_IF" >/dev/null 2>&1 && ip link delete "$HOST_IF"
rm -rf "/etc/netns/$NS"
exit 0
