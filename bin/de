#!/usr/bin/python3

import argparse
import getpass
import hashlib
import itertools
import json
import os
from pathlib import Path
import pwd
import re
import socket
import subprocess
import sys
import time
import shutil
import textwrap
from urllib.error import HTTPError
from urllib.request import Request, urlopen

API = "https://ex.1580.ru/api"
RUNTIME = Path("/run/user") / str(os.getuid())
CACHE = RUNTIME / "digital-examen-cli"
STATE = Path("/run/digital-examen")


def request(path, body=None, token=None):
    headers = {"User-Agent": "Digital-Examen-de"}
    if body is not None:
        headers["Content-Type"] = "application/json"
    data = json.dumps(body).encode() if body is not None else None
    outgoing = Request(API + path, data, headers)
    if token:
        outgoing.add_unredirected_header("Authorization", "Bearer " + token)
    with urlopen(outgoing, timeout=15) as answer:
        return json.load(answer)


def login():
    username = input("Логин сайта: ").strip()
    password = getpass.getpass("Пароль сайта: ")
    challenge = request("/auth/pow/challenge", {"platform": "desktop"})
    challenge_id = challenge["challenge_id"]
    prefix = (challenge_id + challenge["nonce"]).encode()
    difficulty = int(challenge["difficulty"])
    if not 0 <= difficulty <= 26:
        raise ValueError("Неизвестный формат проверки входа")
    for number in itertools.count():
        solution = str(number)
        digest = hashlib.sha256(prefix + solution.encode()).digest()
        if not int.from_bytes(digest, "big") >> (256 - difficulty):
            break
        if number % 4096 == 0 and time.time() >= challenge["expires_at"]:
            raise ValueError("Время проверки входа истекло")
    session = request("/auth/login", {
        "login": username, "password": password, "device_name": socket.gethostname() + " · de",
        "pow_challenge_id": challenge_id, "pow_solution": solution,
    })
    return request("/computers/cli/session", {}, session["access_token"])["access_token"]


def computer(name):
    path = "/computers/cli/computers/" + name
    if CACHE.is_file():
        try:
            return request(path, token=CACHE.read_text())
        except HTTPError as error:
            if error.code not in (401, 403):
                raise
            CACHE.unlink(missing_ok=True)
    token = login()
    try:
        control("lesson-login", token=token)
    except (OSError, ValueError):
        pass
    try:
        if RUNTIME.stat().st_uid == os.getuid():
            descriptor = os.open(CACHE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
            with os.fdopen(descriptor, "w") as output:
                output.write(token)
    except OSError:
        pass
    return request(path, token=token)


def require_local_admin():
    if os.geteuid() != 0:
        os.execvp("sudo", ["sudo", "-n", "--", "/usr/local/bin/de", *sys.argv[1:]])


def control(action, **arguments):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(8)
        client.connect(str(STATE / "control.sock"))
        client.sendall(json.dumps({"action": action, **arguments}).encode() + b"\n")
        with client.makefile() as stream:
            answer = json.loads(stream.readline())
    if "error" in answer:
        raise ValueError(answer["error"])
    return answer


def history():
    events = control("history")["history"]
    if not events:
        print("Блокировок с момента загрузки нет.")
        return
    width = max(55, shutil.get_terminal_size((100, 24)).columns)
    columns = (8, width - 42, 28)
    row = "{:<%d}  {:<%d}  {}" % columns[:2]
    print(row.format("Время", "URL", "Причина / группа / условие"))
    for stamp, url, reason, group, trigger in reversed(events):
        detail = " / ".join(value for value in (reason, group, trigger) if value)
        clean = lambda value: "".join(ch if ch.isprintable() else " " for ch in value)
        urls = textwrap.wrap(clean(url), columns[1]) or [""]
        details = textwrap.wrap(clean(detail), columns[2]) or [""]
        stamp = time.strftime("%H:%M:%S", time.localtime(stamp))
        for address, note in itertools.zip_longest(urls, details, fillvalue=""):
            print(row.format(stamp, address, note))
            stamp = ""


def toggle(action, value):
    flag = STATE / ("adblocker-off" if action == "adblocker" else "vpn-on")
    default = "on" if action == "adblocker" else "off"
    if value != "status":
        require_local_admin()
        STATE.mkdir(mode=0o755, parents=True, exist_ok=True)
        if value == default:
            flag.unlink(missing_ok=True)
        else:
            flag.touch(mode=0o600)
    enabled = flag.exists() == (default == "off")
    print("%s %s" % (action, "on" if enabled else "off"))


def main():
    parser = argparse.ArgumentParser(prog="de", description="Управление школьным компьютером")
    commands = parser.add_subparsers(dest="action", required=True)
    descriptions = {
        "help": "Показать список команд. Для аргументов конкретной команды используй de <команда> --help.",
        "list": "Показать группы ограничений, назначенные этому компьютеру. Требуется вход оператора на сайт.",
        "status": "Показать доступность компьютера, последний сигнал и состояние служб агента.",
        "update": "Запросить штатное обновление агента и получить ответ, не дожидаясь установки.",
        "history": "Показать до 50 последних блокировок с URL, причинами, группами и условиями. Журнал обнуляется при перезагрузке.",
        "ssh": "Проверить вход оператора на сайте и открыть SSH с ключом. root запрашивает sudo в удалённом сеансе.",
        "adblocker": "Показать состояние или включить блокировку рекламных ресурсов. После перезагрузки режим on.",
        "block": "Временно переключить интернет-фильтр с входом оператора. После загрузки компьютера фильтр включён.",
        "screen": "Временно переключить отправку кадров с входом оператора. После загрузки компьютера отправка разрешена.",
        "vpn": "Показать состояние или разрешить трафик через системные VPN-интерфейсы. После перезагрузки режим off.",
    }
    parsers = {name: commands.add_parser(name, help=description, description=description)
               for name, description in descriptions.items()}
    parsers["ssh"].add_argument("computer", help="Номер компьютера, например 5k-100-1")
    parsers["ssh"].add_argument("user", nargs="?", help="Учётная запись на целевом компьютере")
    for name in ("adblocker", "vpn"):
        parsers[name].add_argument("mode", choices=("on", "off", "status"), nargs="?", default="status")
    for name in ("block", "screen"):
        parsers[name].add_argument("mode", choices=("on", "off"))
    args = parser.parse_args()
    if args.action == "help":
        parser.print_help()
        return
    if args.action in ("block", "screen"):
        answer = control(args.action, mode=args.mode, token=login())
        print(args.action, answer["mode"])
        return
    if args.action == "history":
        history()
        return
    if args.action in ("adblocker", "vpn"):
        toggle(args.action, args.mode)
        return
    if args.action == "update":
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as request_socket:
            request_socket.settimeout(1)
            request_socket.sendto(b"1", "/run/de-update-request.sock")
        print("Запрос на обновление отправлен.")
        return
    name = args.computer if args.action == "ssh" else socket.gethostname()
    place = re.fullmatch(r"[a-z]1580-([0-9]{1,2})-([0-9]{1,4})-([0-9]{1,3})", name)
    if place is None or not all(map(int, place.groups())):
        raise ValueError("Введите hostname компьютера в формате m1580-1-100-1")

    if args.action == "ssh" and args.user:
        if not re.fullmatch(r"[a-zA-Z_][a-zA-Z0-9_.-]{0,63}", args.user):
            raise ValueError("Некорректное имя пользователя SSH")
        host = computer(name)["hostname"]
        command = ["ssh", "-o", "BatchMode=yes"]
        if host == socket.gethostname().split(".", 1)[0]:
            command.extend(["-o", "HostKeyAlias=" + host])
            host = "127.0.0.1"
        if args.user == "root":
            uid = int(os.environ.get("SUDO_UID", "0")) if os.getuid() == 0 else os.getuid()
            account = pwd.getpwuid(uid).pw_name
            command.extend(["-tt", "-l", account, "--", host, "sudo", "-n", "--", "/bin/bash", "-l"])
        else:
            command.extend(["-l", args.user, "--", host])
        os.execvp("ssh", command)

    data = computer(name)
    if args.action == "ssh":
        os.execvp("ssh", ["ssh", "-o", "BatchMode=yes", "--", data["hostname"]])
    elif args.action == "list":
        print(json.dumps(data["policy"]["groups"], ensure_ascii=False, indent=2))
    else:
        print(data["name"], "Включён" if data["online"] else "Выключен")
        print("Последний сигнал", data["last_seen"] or "нет данных", flush=True)
        subprocess.call(["systemctl", "show", "--property=Id,ActiveState,SubState",
                         "de-agent.service", "de-net.service", "de-inspect.service", "de-update.timer"])


if __name__ == "__main__":
    try:
        main()
    except HTTPError as error:
        try:
            message = json.load(error).get("detail", "")
        except ValueError:
            message = ""
        sys.exit(str(message or error))
    except (OSError, ValueError, EOFError) as error:
        sys.exit(str(error))
