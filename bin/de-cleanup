#!/bin/sh

CONFIG_FILE=/etc/digital-examen/computers.conf
STATE_DIR=/var/lib/digital-examen/users

[ -f "$CONFIG_FILE" ] && . "$CONFIG_FILE"

GROUP="${DE_USER_GROUP:-de-students}"
LOG="${DE_LOG_FILE:-/var/log/digital-examen-computers.log}"
PROTECTED="${DE_PROTECTED_USERS:-root}"

write_log() {
    echo "`date '+%Y-%m-%d %H:%M:%S'` de-cleanup $1" >> "$LOG"
}

is_protected() {
    lower=`echo "$1" | tr 'A-Z' 'a-z'`
    for name in $PROTECTED; do
        [ "$name" = "$1" ] && return 0
        [ "`echo \"$name\" | tr 'A-Z' 'a-z'`" = "$lower" ] && return 0
    done
    return 1
}

is_ours() {
    [ -f "$STATE_DIR/$1" ] && return 0
    primary=`id -gn "$1" 2>/dev/null`
    [ "$primary" = "$GROUP" ] && return 0
    return 1
}

read_alias() {
    [ -f "$STATE_DIR/$1" ] || return 0
    grep '^alias=' "$STATE_DIR/$1" | head -1 | cut -d= -f2
}

kill_sessions() {
    loginctl terminate-user "$1" >/dev/null 2>&1
    pkill -KILL -u "$1" >/dev/null 2>&1
}

remove_user() {
    name=`echo "$1" | tr 'A-Z' 'a-z'`

    if is_protected "$name"; then
        write_log "refused to touch protected user $name"
        return
    fi

    if ! is_ours "$name"; then
        write_log "refused to touch foreign user $name"
        return
    fi

    home=`getent passwd "$name" | cut -d: -f6`
    alias_name=`read_alias "$name"`

    kill_sessions "$name"
    [ -n "$alias_name" ] && kill_sessions "$alias_name"
    sleep 1

    /usr/local/sbin/de-netns-user down "$name" >/dev/null 2>&1

    box="/run/digital-examen/box-$name"
    mountpoint -q "$box/root" && umount "$box/root"
    rm -rf "$box"
    rm -f "/run/digital-examen/login-$name"
    rm -f "/run/digital-examen/informatics-$name"
    rm -f "/run/digital-examen/offline-$name"

    if [ -n "$home" ]; then
        mountpoint -q "$home" && umount "$home"
        mountpoint -q "$home" && umount -l "$home"
    fi

    if [ -n "$alias_name" ] && getent passwd "$alias_name" >/dev/null 2>&1; then
        /usr/sbin/userdel --force "$alias_name" >/dev/null 2>&1
        write_log "removed alias $alias_name"
    fi

    /usr/sbin/userdel --remove --force "$name" >/dev/null 2>&1

    if [ -n "$home" ] && [ -d "$home" ] && [ "$home" != "/" ] && [ "$home" != "/home" ]; then
        rm -rf "$home"
    fi

    rm -f "$STATE_DIR/$name"
    write_log "removed user $name"
}

collect_users() {
    if [ -d "$STATE_DIR" ]; then
        for path in "$STATE_DIR"/*; do
            [ -f "$path" ] && basename "$path"
        done
    fi

    group_gid=`getent group "$GROUP" | cut -d: -f3`
    [ -z "$group_gid" ] && return 0

    getent passwd | while IFS=: read -r name password uid gid rest; do
        [ "$gid" = "$group_gid" ] && echo "$name"
    done
}

if [ -n "$1" ]; then
    remove_user "$1"
    exit 0
fi

collect_users | tr 'A-Z' 'a-z' | sort -u | while read -r name; do
    [ -n "$name" ] && remove_user "$name"
done

exit 0
