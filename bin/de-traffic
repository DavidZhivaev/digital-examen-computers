#!/usr/bin/python3

from collections import deque
import json
import os
import pwd
import socket
import struct
import sys
import threading
import time

sys.path.insert(0, "/usr/local/lib/digital-examen")

import de_common

API = de_common.setting("DE_API_URL")
COMPUTER = de_common.computer()
QUEUE = os.path.join(de_common.RUN_DIR, "traffic-queue.jsonl")
LEGACY_QUEUE = os.path.join(de_common.STATE_DIR, "traffic-queue.jsonl")
SOCKET_PATH = os.path.join(de_common.RUN_DIR, "traffic.sock")
FLUSH = 2
MAX_PER_FLUSH = 2000
MAX_QUEUE = 50000
MAX_BYTES = 16 * 1024 * 1024
KINDS = ("site", "block", "command", "alarm")
LOCK = threading.Lock()


def keep(record):
    kind = record.get("kind")
    if kind not in KINDS:
        kind = "site"
    value = str(record.get("value", ""))[:255]
    login = str(record.get("login", ""))[:255]
    if not value or not login:
        return
    try:
        at = int(record.get("at") or time.time())
    except (TypeError, ValueError):
        at = int(time.time())
    line = json.dumps({"kind": kind, "value": value, "at": at, "login": login})
    with LOCK:
        try:
            descriptor = os.open(QUEUE, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
            with os.fdopen(descriptor, "a") as queue:
                if queue.tell() < MAX_BYTES:
                    queue.write(line + "\n")
        except IOError:
            pass


def listen():
    os.makedirs(os.path.dirname(SOCKET_PATH), exist_ok=True)
    if os.path.exists(SOCKET_PATH):
        os.remove(SOCKET_PATH)
    server = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
    server.setsockopt(socket.SOL_SOCKET, socket.SO_PASSCRED, 1)
    server.bind(SOCKET_PATH)
    os.chmod(SOCKET_PATH, 0o222)
    credential_size = struct.calcsize("3i")
    while True:
        try:
            data, controls, _, _ = server.recvmsg(4096, socket.CMSG_SPACE(credential_size))
            record = json.loads(data.decode("utf-8"))
            if not isinstance(record, dict):
                continue
            for level, kind, credentials in controls:
                if level != socket.SOL_SOCKET or kind != socket.SCM_CREDENTIALS:
                    continue
                _, uid, _ = struct.unpack("3i", credentials)
                if uid != 0:
                    if record.get("kind") != "command":
                        break
                    record["login"] = pwd.getpwuid(uid).pw_name
                keep(record)
                break
        except (OSError, ValueError, KeyError):
            continue


def take_queue(queue, pending):
    with LOCK:
        if not os.path.exists(pending) and os.path.exists(queue):
            os.replace(queue, pending)
    if not os.path.exists(pending):
        return []
    out = []
    with open(pending) as source:
        for line in deque(source, maxlen=MAX_QUEUE):
            try:
                out.append(json.loads(line))
            except ValueError:
                continue
    return out


def checkpoint(pending, entries):
    if not entries:
        if os.path.exists(pending):
            os.unlink(pending)
        return
    text = "".join(json.dumps(item) + "\n" for item in entries)
    de_common.write_file(pending, text, 0o600)


def post(login, entries):
    answer = de_common.send_json(API.rstrip("/") + "/api/computers/device/traffic", {
        "computer": COMPUTER,
        "login": login,
        "entries": entries,
    }, "proxy", 25)
    if not answer.get("ok"):
        raise ValueError("сервер не подтвердил приём трафика")


def flush():
    queue = LEGACY_QUEUE if os.path.exists(LEGACY_QUEUE) or os.path.exists(LEGACY_QUEUE + ".sending") else QUEUE
    pending = queue + ".sending"
    entries = take_queue(queue, pending)
    groups = {}
    for item in entries[:MAX_PER_FLUSH]:
        groups.setdefault(item["login"], []).append(item)
    for login, items in groups.items():
        try:
            post(login, [{"kind": item["kind"], "value": item["value"], "at": item["at"]}
                         for item in items])
        except (OSError, ValueError) as error:
            de_common.log("de-traffic", "отправка не прошла: %s" % error)
            continue
        sent = {id(item) for item in items}
        entries = [item for item in entries if id(item) not in sent]
        checkpoint(pending, entries)
    if not entries:
        checkpoint(pending, [])


def main():
    if not API or not COMPUTER:
        time.sleep(300)
        return 0
    os.makedirs(de_common.STATE_DIR, exist_ok=True)
    threading.Thread(target=listen, daemon=True).start()
    while True:
        time.sleep(FLUSH)
        try:
            flush()
        except Exception as error:
            de_common.log("de-traffic", "отправка не прошла: %s" % error)


if __name__ == "__main__":
    sys.exit(main())
