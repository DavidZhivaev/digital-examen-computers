#!/usr/bin/python3

import glob
import http.client
import io
import json
import os
import pwd
import shutil
import stat
import sys
import threading
import tempfile
import time
from urllib.parse import urlsplit
import zlib

from PIL import Image

sys.path.insert(0, "/usr/local/lib/digital-examen")

import de_common

URL = de_common.setting("DE_SCREEN_URL")
COMPUTER = de_common.computer()

LIVE_SIZE = (1280, 720)
STORE_SIZE = (1024, 576)
TILE = 16
QUALITY = int(de_common.setting("DE_SCREEN_QUALITY", "50"))
KEY_EVERY = 120
KEY_SHARE = 40
STORE_INTERVAL = float(de_common.setting("DE_SCREEN_INTERVAL", "2"))
LIVE_INTERVAL = 1
WATCH_INTERVAL = 3
GRAB_SECONDS = 6

WORK_DIR = os.path.join(de_common.RUN_DIR, "screen")
MODE_FILE = os.path.join(de_common.RUN_DIR, "screen-mode")
QUEUE_DIR = os.path.join(de_common.STATE_DIR, "screen-queue")
QUEUE_LIMIT = 20 * 1024 * 1024
QUEUE_MIN_FREE = 512 * 1024 * 1024
WAYLAND_SHOT = "/usr/bin/spectacle"


def log(message):
    de_common.log("de-screen", message)


def read_mode():
    try:
        return int(de_common.read_file(MODE_FILE) or "0")
    except ValueError:
        return 0


def xauth_files(login, display):
    out = []
    try:
        entry = pwd.getpwnam(login)
        env = de_common.user_env(entry.pw_uid, "XAUTHORITY")
        if env.get("DISPLAY") == display and env.get("XAUTHORITY"):
            out.append(env["XAUTHORITY"])
        out.extend(sorted(glob.glob("/run/user/%d/xauth_*" % entry.pw_uid)))
        out.append(os.path.join(entry.pw_dir, ".Xauthority"))
    except KeyError:
        pass
    out.extend(sorted(glob.glob("/run/sddm/*")))
    out.extend(sorted(glob.glob("/var/run/sddm/*")))
    out.append("")
    return out


def to_image(data):
    picture = Image.open(io.BytesIO(data))
    if picture.mode != "RGB":
        picture = picture.convert("RGB")
    if picture.size != LIVE_SIZE:
        picture = picture.resize(LIVE_SIZE, Image.BILINEAR)
    return picture


def grab_x11(display, xauth):
    target = os.path.join(WORK_DIR, "x11.bmp")
    env = {"DISPLAY": display, "PATH": "/usr/bin:/bin"}
    if xauth:
        env["XAUTHORITY"] = xauth
    code, output = de_common.run([
        "ffmpeg", "-loglevel", "error", "-f", "x11grab", "-i", display,
        "-frames:v", "1", "-y", target,
    ], GRAB_SECONDS, env)
    if code != 0 or not os.path.exists(target):
        return None
    data = open(target, "rb").read()
    os.remove(target)
    return to_image(data)


def set_display_scale(session):
    login = session.get("Name", "")
    if session.get("Type") != "wayland" or de_common.is_admin(login):
        return
    entry = pwd.getpwnam(login)
    values = de_common.user_env(entry.pw_uid, "WAYLAND_DISPLAY")
    doctor = shutil.which("kscreen-doctor")
    if not doctor or not values:
        return
    env = de_common.session_env(entry, values)
    command = ["/usr/bin/setpriv", "--reuid", str(entry.pw_uid), "--regid", str(entry.pw_gid),
               "--init-groups", doctor]
    code, output = de_common.run(command + ["-j"], 4, env)
    if code:
        return
    try:
        outputs = json.loads(output)["outputs"]
        changes = ["output.%d.scale.1" % item["id"] for item in outputs
                   if item.get("connected") and item.get("enabled") and item.get("scale", 1) != 1]
    except (KeyError, TypeError, ValueError):
        return
    if changes:
        de_common.run(command + changes, 4, env)


WAYLAND_ENV = {}


def grab_wayland(login, session_id):
    try:
        entry = pwd.getpwnam(login)
    except KeyError:
        return None
    key = (entry.pw_uid, session_id)
    now = time.monotonic()
    if WAYLAND_ENV.get("key") != key or now >= WAYLAND_ENV.get("expires", 0):
        values = de_common.user_env(entry.pw_uid, "WAYLAND_DISPLAY")
        if not values:
            return None
        env = de_common.session_env(entry, values)
        state = os.path.join(WORK_DIR, "spectacle-%d" % entry.pw_uid)
        try:
            if not os.path.lexists(state):
                os.mkdir(state, 0o700)
                os.chown(state, entry.pw_uid, entry.pw_gid)
            details = os.stat(state, follow_symlinks=False)
            if stat.S_ISDIR(details.st_mode) and details.st_uid == entry.pw_uid:
                env["XDG_CONFIG_HOME"] = os.path.join(state, "config")
                env["XDG_CACHE_HOME"] = os.path.join(state, "cache")
        except OSError:
            pass
        WAYLAND_ENV.update(key=key, expires=now + 15, env=env)
    env = dict(WAYLAND_ENV["env"], QT_QPA_PLATFORM="wayland")
    try:
        with tempfile.TemporaryDirectory(dir=WORK_DIR) as folder:
            os.chown(folder, entry.pw_uid, entry.pw_gid)
            env.setdefault("XDG_CONFIG_HOME", folder)
            env.setdefault("XDG_CACHE_HOME", folder)
            formats = ("png",) if WAYLAND_ENV.get("png_only") == key else ("bmp", "png")
            for image_format in formats:
                shot = os.path.join(folder, "screen." + image_format)
                code, _ = de_common.run([
                    "/usr/bin/setpriv", "--reuid", str(entry.pw_uid), "--regid", str(entry.pw_gid),
                    "--init-groups", WAYLAND_SHOT, "-b", "-n", "-i", "-f", "-d", "0", "-o", shot,
                ], GRAB_SECONDS, env)
                if code or not os.path.exists(shot):
                    continue
                descriptor = os.open(shot, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
                with os.fdopen(descriptor, "rb") as source:
                    details = os.fstat(source.fileno())
                    if not stat.S_ISREG(details.st_mode) or details.st_size > 32 * 1024 * 1024:
                        continue
                    picture = to_image(source.read(32 * 1024 * 1024))
                    if image_format == "png":
                        WAYLAND_ENV["png_only"] = key
                    return picture
    except (OSError, ValueError):
        pass
    return None



class Target:

    def __init__(self):
        self.key = ""
        self.display = ""
        self.xauth = ""


TARGET = Target()


def grab(session):
    login = session.get("Name", "")
    if session.get("Type") == "wayland" and session.get("Class") != "greeter":
        return grab_wayland(login, session.get("Id", ""))

    key = session.get("Id", "")
    if TARGET.key == key and TARGET.display:
        picture = grab_x11(TARGET.display, TARGET.xauth)
        if picture is not None:
            return picture

    display = session.get("Display", "")
    if not display and session.get("Leader"):
        display = de_common.process_env(session["Leader"]).get("DISPLAY", "")
    displays = [display] if display else []
    for display in displays:
        for xauth in xauth_files(login, display):
            picture = grab_x11(display, xauth)
            if picture is not None:
                TARGET.key = key
                TARGET.display = display
                TARGET.xauth = xauth
                return picture
    TARGET.key = ""
    if session.get("Type") == "wayland":
        return grab_wayland(login, session.get("Id", ""))
    return None


def webp(picture):
    out = io.BytesIO()
    picture.save(out, "WEBP", quality=QUALITY, method=0)
    return out.getvalue()


class Stream:

    def __init__(self, kind, size):
        self.kind = kind
        self.frame_no = int(time.time() * 1000)
        self.resize(size)

    def resize(self, size):
        self.size = size
        self.cols = size[0] // TILE
        self.rows = size[1] // TILE
        self.total = self.cols * self.rows
        self.reset()

    def reset(self):
        self.previous = None
        self.since_key = 0

    def hashes(self, picture):
        data = picture.tobytes()
        stride = self.size[0] * 3
        width = TILE * 3
        out = []
        for row in range(self.rows):
            for col in range(self.cols):
                value = 0
                left = col * width
                for y in range(row * TILE, row * TILE + TILE):
                    start = y * stride + left
                    value = zlib.crc32(data[start:start + width], value)
                out.append(value)
        return out

    def runs(self, changed):
        marks = set(changed)
        out = []
        for row in range(self.rows):
            col = 0
            while col < self.cols:
                if row * self.cols + col in marks:
                    start = col
                    while col < self.cols and row * self.cols + col in marks:
                        col += 1
                    out.append((start, row, col - start))
                else:
                    col += 1
        return out

    def build(self, picture):
        current = self.hashes(picture)
        if self.previous is None:
            changed = list(range(self.total))
        else:
            changed = [i for i in range(self.total) if self.previous[i] != current[i]]

        keyframe = self.previous is None or self.since_key >= KEY_EVERY
        if len(changed) * 100 >= self.total * KEY_SHARE:
            keyframe = True

        if keyframe:
            pieces = [[(-1, 0, 0), webp(picture)]]
        else:
            pieces = []
            for col, row, width in self.runs(changed):
                box = (col * TILE, row * TILE, (col + width) * TILE, row * TILE + TILE)
                pieces.append([(col, row, width), webp(picture.crop(box))])
        return current, keyframe, pieces

    def body(self, login, keyframe, pieces):
        header = {
            "version": 4,
            "kind": self.kind,
            "computer": COMPUTER,
            "login": login,
            "frame": self.frame_no,
            "time": int(time.time()),
            "size": [self.size[0], self.size[1]],
            "grid": [self.cols, self.rows],
            "tile": TILE,
            "keyframe": keyframe,
            "pieces": [[run[0], run[1], run[2], len(blob)] for run, blob in pieces],
        }
        data = json.dumps(header).encode() + b"\n"
        for run, blob in pieces:
            data += blob
        return data


class FrameConnection:
    def __init__(self, timeout):
        self.target = urlsplit(URL.rstrip("/") + "/frame")
        kind = http.client.HTTPSConnection if self.target.scheme == "https" else http.client.HTTPConnection
        self.connection = kind(self.target.hostname, self.target.port, timeout=timeout)

    def post(self, body):
        headers = {
            "Content-Type": "application/octet-stream",
            "X-De-Computer": COMPUTER,
            "X-De-Secret": de_common.secret("screen"),
        }
        try:
            self.connection.request("POST", self.target.path, body, headers)
            response = self.connection.getresponse()
            data = response.read()
            if response.status != 200:
                raise OSError("приёмник кадров ответил HTTP %d" % response.status)
            return json.loads(data)
        except (OSError, http.client.HTTPException, ValueError) as error:
            self.connection.close()
            raise OSError(str(error)) from error


def queue_files():
    return sorted(glob.glob(os.path.join(QUEUE_DIR, "*.frame")))


def drop_oldest(files, needed):
    freed = 0
    for path in files:
        if freed >= needed:
            break
        try:
            freed += os.path.getsize(path)
            os.remove(path)
        except OSError:
            continue


def remember(body, frame_no):
    try:
        os.makedirs(QUEUE_DIR, mode=0o700, exist_ok=True)
        files = queue_files()
        size = sum(os.path.getsize(path) for path in files if os.path.exists(path))
        free = shutil.disk_usage(QUEUE_DIR).free
        needed = max(size + len(body) - QUEUE_LIMIT, QUEUE_MIN_FREE + len(body) - free)
        if needed > 0:
            drop_oldest(files, needed)
        path = os.path.join(QUEUE_DIR, "%013d.frame" % frame_no)
        with open(path + ".new", "wb") as output:
            output.write(body)
        os.replace(path + ".new", path)
        return needed <= 0
    except OSError:
        return False


def screen_enabled():
    return de_common.read_file(de_common.SCREEN_ENABLED_FILE) != "0"



class Senders:

    def __init__(self):
        self.watch = (0, 0.0)
        self.live_frame = None
        self.live_ready = threading.Condition()
        self.archive_ready = threading.Event()
        self.archive_picture = None
        self.archive_capture_ready = threading.Condition()

    def publish_live(self, body):
        with self.live_ready:
            self.live_frame = body
            self.live_ready.notify()

    def clear_live(self):
        with self.live_ready:
            self.live_frame = None

    def post(self, connection, body):
        answer = connection.post(body)
        self.watch = (int(answer.get("interval", 0)), time.monotonic())

    def live_loop(self):
        connection = FrameConnection(1.5)
        while True:
            with self.live_ready:
                self.live_ready.wait_for(lambda: self.live_frame is not None)
                body = self.live_frame
                self.live_frame = None
            if not screen_enabled():
                continue
            try:
                self.post(connection, body)
            except (OSError, ValueError):
                pass

    def publish_archive(self, key, login, picture):
        with self.archive_capture_ready:
            self.archive_picture = (key, login, picture)
            self.archive_capture_ready.notify()

    def build_archive(self):
        storage = Stream("store", STORE_SIZE)
        last_key = None
        while True:
            with self.archive_capture_ready:
                self.archive_capture_ready.wait_for(lambda: self.archive_picture is not None)
                key, login, picture = self.archive_picture
                self.archive_picture = None
            if not screen_enabled():
                last_key = None
                continue
            if key != last_key:
                storage.reset()
                last_key = key
            current, keyframe, pieces = storage.build(picture.resize(STORE_SIZE, Image.BILINEAR))
            if not pieces:
                continue
            kept = remember(storage.body(login, keyframe, pieces), storage.frame_no)
            storage.frame_no += 1
            if kept:
                storage.previous = current
                storage.since_key = 0 if keyframe else storage.since_key + 1
            else:
                storage.reset()
            self.archive_ready.set()

    def archive_loop(self):
        connection = FrameConnection(8)
        while True:
            self.archive_ready.wait(timeout=2)
            self.archive_ready.clear()
            if not screen_enabled():
                continue
            for path in queue_files():
                if not screen_enabled():
                    break
                try:
                    with open(path, "rb") as source:
                        header = source.readline()
                        if json.loads(header).get("computer") != COMPUTER:
                            continue
                        body = header + source.read()
                except (OSError, ValueError):
                    continue
                if not screen_enabled():
                    break
                try:
                    self.post(connection, body)
                except (OSError, ValueError):
                    time.sleep(2)
                    break
                try:
                    os.unlink(path)
                except FileNotFoundError:
                    pass


def main():
    if not URL or not COMPUTER:
        log("компьютер не на учёте, запись ждёт")
        time.sleep(300)
        return 0

    os.makedirs(WORK_DIR, exist_ok=True)
    os.chmod(WORK_DIR, 0o711)
    log("запись экрана запущена")

    live = Stream("live", LIVE_SIZE)
    senders = Senders()
    threading.Thread(target=senders.live_loop, daemon=True).start()
    threading.Thread(target=senders.archive_loop, daemon=True).start()
    threading.Thread(target=senders.build_archive, daemon=True).start()
    next_store = 0.0
    next_live = 0.0
    previous_pixels, live_blob = b"", b""
    last_key = ""
    scale_due = 0
    ready_at = 0
    misses = 0

    scale_worker = None
    previous_mode = 0
    while True:
        started = time.monotonic()
        if not screen_enabled():
            senders.clear_live()
            last_key = ""
            time.sleep(1)
            continue
        remote_mode, received_at = senders.watch
        watched = remote_mode if started - received_at < 6 else read_mode()
        if watched != previous_mode:
            next_live = 0.0
            previous_mode = watched
        live_due = bool(watched and started >= next_live)
        store_due = started >= next_store
        archive_near_live = bool(watched and not live_due and next_live - started < .9)
        if not live_due and (not store_due or archive_near_live):
            deadline = next_live if archive_near_live else (min(next_live, next_store) if watched else next_store)
            time.sleep(min(0.15, deadline - started))
            continue
        session = de_common.screen_session()
        if session is None or session.get("Class") == "greeter":
            senders.clear_live()
            last_key = ""
            time.sleep(1)
            continue

        login = session.get("Name", "")

        key = session.get("Id", "") + "/" + login
        if key != last_key:
            senders.clear_live()
            next_store = next_live = 0.0
            previous_pixels, live_blob = b"", b""
            last_key = key
            scale_due = 0
            ready_at = time.monotonic() + 0.5
            misses = 0
        if time.monotonic() < ready_at:
            time.sleep(0.5)
            continue

        if time.monotonic() >= scale_due:
            if scale_worker is None or not scale_worker.is_alive():
                scale_worker = threading.Thread(target=set_display_scale, args=(session,), daemon=True)
                scale_worker.start()
            scale_due = time.monotonic() + 30

        picture = grab(session)
        if picture is None:
            misses += 1
            if misses in (10, 100, 1000):
                log("экран не снимается %d раз подряд, сеанс %s %s" % (misses, login, session.get("Type", "")))
            time.sleep(1)
            continue
        active = de_common.screen_session()
        if active is None or active.get("Id") != session.get("Id"):
            continue
        misses = 0

        if live_due:
            interval = LIVE_INTERVAL if watched == 1 else WATCH_INTERVAL
            next_live = started + interval
            pixels = picture.tobytes()
            if pixels != previous_pixels:
                live_blob = webp(picture)
                previous_pixels = pixels
            senders.publish_live(live.body(login, True, [[(-1, 0, 0), live_blob]]))
            live.frame_no += 1

        if started >= next_store:
            next_store = started + STORE_INTERVAL
            senders.publish_archive(key, login, picture)


if __name__ == "__main__":
    sys.exit(main())
