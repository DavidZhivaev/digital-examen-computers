#!/usr/bin/python3

import glob
import json
import os
import pwd
import shutil
import ssl
import subprocess
import sys
import time
import urllib.error
import urllib.request
import zlib

sys.path.insert(0, "/usr/local/lib/digital-examen")

import de_time

CONFIG_FILE = "/etc/digital-examen/computers.conf"
LOGIN_FILE = "/run/digital-examen/current-login"


def read_config():
    values = {}
    if not os.path.exists(CONFIG_FILE):
        return values
    data = open(CONFIG_FILE)
    for line in data:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        name, value = line.split("=", 1)
        value = value.strip()
        if len(value) > 1 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        values[name.strip()] = value
    data.close()
    return values


CONFIG = read_config()
URL = CONFIG.get("DE_SCREEN_URL", "")
COMPUTER = CONFIG.get("DE_COMPUTER_ID", "")

LIVE_WIDTH = int(CONFIG.get("DE_SCREEN_WIDTH", "1280"))
LIVE_HEIGHT = int(CONFIG.get("DE_SCREEN_HEIGHT", "720"))
STORE_WIDTH = int(CONFIG.get("DE_SCREEN_STORE_WIDTH", "1024"))
STORE_HEIGHT = int(CONFIG.get("DE_SCREEN_STORE_HEIGHT", "576"))

TILE = int(CONFIG.get("DE_SCREEN_TILE", "16"))
QUALITY = CONFIG.get("DE_SCREEN_QUALITY", "50")
COLORS = int(CONFIG.get("DE_SCREEN_COLORS", "8"))
KEY_EVERY = int(CONFIG.get("DE_SCREEN_KEYFRAME_EVERY", "120"))
KEY_SHARE = int(CONFIG.get("DE_SCREEN_KEYFRAME_SHARE", "40"))

STORE_INTERVAL = float(CONFIG.get("DE_SCREEN_INTERVAL", "2"))
WATCH_INTERVAL = float(CONFIG.get("DE_SCREEN_WATCH_INTERVAL", "2"))
LIVE_INTERVAL = float(CONFIG.get("DE_SCREEN_LIVE_INTERVAL", "1"))

# Писать ли архив на переменах. Выключение экономит около пятой части
# диска, но тогда переменa остаётся незаписанной — решение школы, а не
# наше, поэтому по умолчанию пишем всегда.
SKIP_BREAKS = CONFIG.get("DE_SCREEN_LESSONS_ONLY", "0") == "1"

WORK_DIR = CONFIG.get("DE_SCREEN_WORK_DIR", "/run/digital-examen/screen")
SECRET_FILE = CONFIG.get("DE_SCREEN_SECRET_FILE", CONFIG.get("DE_PROXY_SECRET_FILE", "/etc/digital-examen/proxy.secret"))
MODE_FILE = CONFIG.get("DE_SCREEN_MODE_FILE", "/run/digital-examen/screen-mode")

QUEUE_DIR = CONFIG.get("DE_SCREEN_QUEUE_DIR", "/var/lib/digital-examen/screen-queue")
QUEUE_LIMIT = int(CONFIG.get("DE_SCREEN_QUEUE_LIMIT_KB", "20480")) * 1024
QUEUE_MIN_FREE = int(CONFIG.get("DE_SCREEN_MIN_FREE_MB", "512")) * 1024 * 1024
QUEUE_SEND_PER_CYCLE = int(CONFIG.get("DE_SCREEN_QUEUE_SEND", "3"))
GREETER_LOGIN = CONFIG.get("DE_SCREEN_GREETER_LOGIN", "_greeter")
ALWAYS = CONFIG.get("DE_SCREEN_ALWAYS", "1") == "1"
LOG = CONFIG.get("DE_LOG_FILE", "/var/log/digital-examen-computers.log")

LIVE_RAW = os.path.join(WORK_DIR, "live.rgb")
STORE_RAW = os.path.join(WORK_DIR, "store.rgb")


def log(message):
    stamp = time.strftime("%Y-%m-%d %H:%M:%S")
    try:
        out = open(LOG, "a")
        out.write(stamp + " de-screen " + message + "\n")
        out.close()
    except IOError:
        pass


def build_opener():
    ca = CONFIG.get("DE_SCREEN_CA", "")
    if not ca or not os.path.exists(ca):
        return urllib.request.build_opener()
    context = ssl.create_default_context(cafile=ca)
    context.check_hostname = True
    context.verify_mode = ssl.CERT_REQUIRED
    return urllib.request.build_opener(urllib.request.HTTPSHandler(context=context))


OPENER = build_opener()


def read_file(path):
    if not os.path.exists(path):
        return ""
    return open(path).read().strip()


def read_mode():
    value = read_file(MODE_FILE)
    try:
        return int(value)
    except ValueError:
        return 0


SCREEN_TARGET = {"display": "", "xauth": ""}


def run_quiet(command, env=None):
    merged = dict(os.environ)
    if env:
        merged.update(env)
    return subprocess.call(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, env=merged)


LOGINCTL = "/usr/bin/loginctl"
if not os.path.exists(LOGINCTL):
    LOGINCTL = "/bin/loginctl"


def session_rows():
    try:
        output = subprocess.check_output(
            [LOGINCTL, "list-sessions", "--no-legend"],
            stderr=subprocess.DEVNULL,
        ).decode("utf-8", "replace")
    except (subprocess.CalledProcessError, OSError):
        return []
    rows = []
    for line in output.splitlines():
        parts = line.split()
        if parts:
            rows.append(parts[0])
    return rows


def session_fields(session):
    try:
        output = subprocess.check_output(
            [LOGINCTL, "show-session", session,
             "-p", "Name", "-p", "Active", "-p", "Type", "-p", "Display", "-p", "Class"],
            stderr=subprocess.DEVNULL,
        ).decode("utf-8", "replace")
    except (subprocess.CalledProcessError, OSError):
        return {}
    values = {}
    for line in output.splitlines():
        if "=" in line:
            name, value = line.split("=", 1)
            values[name.strip()] = value.strip()
    return values


def active_session():
    """Кто сидит за компьютером прямо сейчас.

    Сначала берётся логин, который положил de-enter-net: это ученик в
    песочнице. Если файла нет, значит сеанс не наш — учитель, администратор
    или штатная учётка машины, — и сеанс ищется через loginctl. Запись не
    зависит от того, кто вошёл: пишем всегда.
    """
    login = read_file(LOGIN_FILE)
    if login:
        return login, ""

    for session in session_rows():
        values = session_fields(session)
        if values.get("Class") == "greeter":
            continue
        if values.get("Active") != "yes":
            continue
        if values.get("Type") not in ("x11", "wayland"):
            continue
        name = values.get("Name", "")
        if name:
            return name, values.get("Display", "")
    return "", ""


def xauth_candidates(login):
    out = []
    env_auth = os.environ.get("XAUTHORITY", "")
    if env_auth:
        out.append(env_auth)
    if login:
        try:
            home = pwd.getpwnam(login).pw_dir
            out.append(os.path.join(home, ".Xauthority"))
            uid = pwd.getpwnam(login).pw_uid
            out.extend(sorted(glob.glob("/run/user/%d/xauth_*" % uid)))
        except KeyError:
            pass
    out.extend(sorted(glob.glob("/run/sddm/*")))
    out.extend(sorted(glob.glob("/var/run/sddm/*")))
    out.append("")
    return out


def display_candidates(hint):
    out = []
    if hint:
        out.append(hint)
    if os.environ.get("DISPLAY"):
        out.append(os.environ["DISPLAY"])
    out.extend([":0", ":1"])
    seen = []
    for item in out:
        if item and item not in seen:
            seen.append(item)
    return seen


def grab_with(display, xauth):
    command = [
        "ffmpeg", "-loglevel", "error",
        "-f", "x11grab", "-i", display,
        "-frames:v", "1",
        "-vf", "scale=%d:%d" % (LIVE_WIDTH, LIVE_HEIGHT),
        "-pix_fmt", "rgb24", "-f", "rawvideo", "-y", LIVE_RAW,
    ]
    env = {"DISPLAY": display}
    if xauth:
        env["XAUTHORITY"] = xauth
    return run_quiet(command, env) == 0


def grab(login, hint):
    if SCREEN_TARGET["display"] and grab_with(SCREEN_TARGET["display"], SCREEN_TARGET["xauth"]):
        return open(LIVE_RAW, "rb").read()

    for display in display_candidates(hint):
        for xauth in xauth_candidates(login):
            if grab_with(display, xauth):
                SCREEN_TARGET["display"] = display
                SCREEN_TARGET["xauth"] = xauth
                return open(LIVE_RAW, "rb").read()

    SCREEN_TARGET["display"] = ""
    SCREEN_TARGET["xauth"] = ""
    raise OSError("экран не снялся")


def shrink():
    command = [
        "magick", "-size", "%dx%d" % (LIVE_WIDTH, LIVE_HEIGHT), "-depth", "8", "rgb:" + LIVE_RAW,
        "-resize", "%dx%d!" % (STORE_WIDTH, STORE_HEIGHT),
        "-depth", "8", "rgb:" + STORE_RAW,
    ]
    subprocess.check_call(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return open(STORE_RAW, "rb").read()


class Stream:

    def __init__(self, kind, width, height, raw):
        self.kind = kind
        self.raw = raw
        self.palette = os.path.join(WORK_DIR, "palette-" + kind + ".png")
        self.frame_no = 0
        self.resize(width, height)

    def resize(self, width, height):
        self.width = width
        self.height = height
        self.cols = width // TILE
        self.rows = height // TILE
        self.total = self.cols * self.rows
        self.reset()

    def reset(self):
        self.previous = None
        self.since_key = 0

    def hashes(self, data):
        out = []
        stride = self.width * 3
        width_bytes = TILE * 3
        for row in range(self.rows):
            for col in range(self.cols):
                value = 0
                left = col * width_bytes
                for y in range(row * TILE, row * TILE + TILE):
                    start = y * stride + left
                    value = zlib.crc32(data[start:start + width_bytes], value)
                out.append(value)
        return out

    def palette_args(self):
        if COLORS <= 0 or not os.path.exists(self.palette):
            return []
        return ["+dither", "-remap", self.palette]

    def make_palette(self):
        if COLORS <= 0:
            return
        command = [
            "magick", "-size", "%dx%d" % (self.width, self.height),
            "-depth", "8", "rgb:" + self.raw,
            "-kmeans", str(COLORS), self.palette,
        ]
        subprocess.check_call(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def find_runs(self, changed):
        marks = set(changed)
        out = []
        for row in range(self.rows):
            col = 0
            while col < self.cols:
                if row * self.cols + col in marks:
                    start = col
                    while col < self.cols and row * self.cols + col in marks:
                        col += 1
                    out.append((start, row, col - start))
                else:
                    col += 1
        return out

    def encode_run(self, run):
        col, row, width = run
        path = os.path.join(WORK_DIR, "%s-r%d_%d.webp" % (self.kind, col, row))
        command = [
            "magick", "-size", "%dx%d" % (self.width, self.height),
            "-depth", "8", "rgb:" + self.raw,
            "-crop", "%dx%d+%d+%d" % (width * TILE, TILE, col * TILE, row * TILE), "+repage",
        ] + self.palette_args() + [
            "-quality", QUALITY, "webp:" + path,
        ]
        subprocess.check_call(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        data = open(path, "rb").read()
        os.remove(path)
        return data

    def encode_full(self):
        path = os.path.join(WORK_DIR, self.kind + "-full.webp")
        command = [
            "magick", "-size", "%dx%d" % (self.width, self.height),
            "-depth", "8", "rgb:" + self.raw,
        ] + self.palette_args() + [
            "-quality", QUALITY, "webp:" + path,
        ]
        subprocess.check_call(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        data = open(path, "rb").read()
        os.remove(path)
        return data

    def build(self, data):
        current = self.hashes(data)

        if self.previous is None:
            changed = list(range(self.total))
        else:
            changed = [i for i in range(self.total) if self.previous[i] != current[i]]

        keyframe = self.previous is None or self.since_key >= KEY_EVERY
        if len(changed) * 100 >= self.total * KEY_SHARE:
            keyframe = True

        if keyframe:
            self.make_palette()
            pieces = [[(-1, 0, 0), self.encode_full()]]
        else:
            pieces = [[run, self.encode_run(run)] for run in self.find_runs(changed)]

        return current, keyframe, pieces

    def header(self, login, keyframe, pieces):
        return {
            "version": 4,
            "kind": self.kind,
            "computer": COMPUTER,
            "login": login,
            "frame": self.frame_no,
            "time": int(time.time()),
            "size": [self.width, self.height],
            "grid": [self.cols, self.rows],
            "tile": TILE,
            "keyframe": keyframe,
            "pieces": [[run[0], run[1], run[2], len(blob)] for run, blob in pieces],
        }


def post_body(body):
    request = urllib.request.Request(URL.rstrip("/") + "/frame", data=body)
    request.add_header("Content-Type", "application/octet-stream")
    request.add_header("X-De-Computer", COMPUTER)
    request.add_header("X-De-Secret", read_file(SECRET_FILE))
    answer = OPENER.open(request, timeout=20)
    return json.loads(answer.read().decode("utf-8"))


def queue_files():
    if not os.path.isdir(QUEUE_DIR):
        return []
    return sorted(glob.glob(os.path.join(QUEUE_DIR, "*.frame")))


def queue_size(files):
    total = 0
    for path in files:
        try:
            total += os.path.getsize(path)
        except OSError:
            continue
    return total


def free_bytes():
    try:
        return shutil.disk_usage(QUEUE_DIR).free
    except OSError:
        return QUEUE_MIN_FREE


def drop_oldest(files, needed):
    """Места нет — уходит самая старая запись, а не новая.

    Правило одно на всю систему: заканчивается диск — удаляем самое старое.
    Так свежая запись никогда не теряется из-за того, что очередь копилась
    неделю, пока компьютер стоял без сети.
    """
    freed = 0
    removed = 0
    for path in files:
        if freed >= needed:
            break
        try:
            freed += os.path.getsize(path)
            os.remove(path)
            removed += 1
        except OSError:
            continue
    if removed:
        log("очередь переполнена, удалено самых старых кадров: %d" % removed)
    return removed


def remember_frame(body):
    try:
        os.makedirs(QUEUE_DIR, exist_ok=True)
        os.chmod(QUEUE_DIR, 0o700)
    except OSError:
        return

    files = queue_files()
    size = queue_size(files)
    if size + len(body) > QUEUE_LIMIT:
        drop_oldest(files, size + len(body) - QUEUE_LIMIT)
    if free_bytes() < QUEUE_MIN_FREE:
        drop_oldest(queue_files(), QUEUE_MIN_FREE)

    name = "%d-%06d.frame" % (int(time.time() * 1000), os.getpid() % 1000000)
    path = os.path.join(QUEUE_DIR, name)
    try:
        out = open(path + ".new", "wb")
        out.write(body)
        out.close()
        os.chmod(path + ".new", 0o600)
        os.replace(path + ".new", path)
    except OSError:
        pass


def flush_queue():
    sent = 0
    for path in queue_files()[:QUEUE_SEND_PER_CYCLE]:
        try:
            body = open(path, "rb").read()
        except OSError:
            continue
        try:
            post_body(body)
        except (urllib.error.URLError, urllib.error.HTTPError, OSError, ValueError):
            return sent
        try:
            os.remove(path)
        except OSError:
            pass
        sent += 1
    return sent


def send(stream, login, keyframe, pieces):
    body = json.dumps(stream.header(login, keyframe, pieces)).encode() + b"\n"
    for run, blob in pieces:
        body += blob

    try:
        return post_body(body)
    except (urllib.error.URLError, urllib.error.HTTPError, OSError, ValueError):
        if stream.kind == "store":
            remember_frame(body)
        return None


def main():
    if not URL or not COMPUTER:
        return 0

    os.makedirs(WORK_DIR, exist_ok=True)
    os.chmod(WORK_DIR, 0o700)
    log("запись экрана запущена")

    live = Stream("live", LIVE_WIDTH, LIVE_HEIGHT, LIVE_RAW)
    store = Stream("store", STORE_WIDTH, STORE_HEIGHT, STORE_RAW)

    watched = 0
    next_store = 0.0
    last_login = ""

    while True:
        started = time.time()
        login, hint = active_session()

        if not login:
            if not ALWAYS:
                store.reset()
                time.sleep(STORE_INTERVAL)
                continue
            login = GREETER_LOGIN

        if login != last_login:
            store.reset()
            live.reset()
            last_login = login

        if SKIP_BREAKS and not watched and not de_time.lesson_now()[0]:
            store.reset()
            time.sleep(STORE_INTERVAL)
            continue

        try:
            raw = grab(login, hint)
        except (subprocess.CalledProcessError, OSError):
            time.sleep(STORE_INTERVAL)
            continue

        answer = None

        if watched:
            try:
                live.make_palette()
                pieces = [[(-1, 0, 0), live.encode_full()]]
                answer = send(live, login, True, pieces)
                live.frame_no += 1
            except (subprocess.CalledProcessError, OSError, ValueError):
                pass

        if started >= next_store:
            next_store = started + STORE_INTERVAL
            try:
                if watched:
                    if store.width != LIVE_WIDTH:
                        store.resize(LIVE_WIDTH, LIVE_HEIGHT)
                    store.raw = LIVE_RAW
                    frame = raw
                else:
                    if store.width != STORE_WIDTH:
                        store.resize(STORE_WIDTH, STORE_HEIGHT)
                    store.raw = STORE_RAW
                    frame = shrink()
                current, keyframe, pieces = store.build(frame)
                if pieces:
                    reply = send(store, login, keyframe, pieces)
                    store.previous = current
                    store.frame_no += 1
                    store.since_key = 0 if keyframe else store.since_key + 1
                    if reply is not None:
                        answer = reply
            except (subprocess.CalledProcessError, OSError, ValueError):
                store.reset()

        if answer is not None:
            flush_queue()

        watched = read_mode()
        if answer is not None and not watched:
            watched = int(answer.get("interval") or 0)

        if watched == 1:
            interval = LIVE_INTERVAL
        elif watched:
            interval = WATCH_INTERVAL
        else:
            interval = STORE_INTERVAL

        rest = interval - (time.time() - started)
        if rest > 0:
            time.sleep(rest)


sys.exit(main())
