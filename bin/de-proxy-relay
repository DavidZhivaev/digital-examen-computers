#!/usr/bin/python3

import base64
import importlib.util
import json
import os
import socket
import socketserver
import subprocess
import sys
import threading
import time

sys.path.insert(0, "/usr/local/lib/digital-examen")

import de_filter
import de_patterns
import de_watch

CONFIG_FILE = "/etc/digital-examen/computers.conf"
LOGIN_FILE = "/run/digital-examen/current-login"


def read_config():
    values = {}
    if not os.path.exists(CONFIG_FILE):
        return values
    data = open(CONFIG_FILE)
    for line in data:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        name, value = line.split("=", 1)
        value = value.strip()
        if len(value) > 1 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        values[name.strip()] = value
    data.close()
    return values


CONFIG = read_config()
LOGIN = sys.argv[1] if len(sys.argv) > 1 else ""
HOST_IP = sys.argv[2] if len(sys.argv) > 2 else CONFIG.get("DE_NETNS_HOST_IP", "10.77.0.1")
PORT = int(CONFIG.get("DE_RELAY_PORT", "3128"))
UP_HOST = CONFIG.get("DE_SCHOOL_PROXY_HOST", "")
UP_FALLBACK = CONFIG.get("DE_SCHOOL_PROXY_FALLBACK", "")
UP_PORT = int(CONFIG.get("DE_SCHOOL_PROXY_PORT", "3128"))
SECRET_FILE = CONFIG.get("DE_PROXY_SECRET_FILE", "/etc/digital-examen/proxy.secret")
TRAFFIC_SOCKET = CONFIG.get("DE_TRAFFIC_SOCKET", "/run/digital-examen/traffic.sock")
POLICY_FILE = CONFIG.get("DE_POLICY_FILE", "/run/digital-examen/policy.json")
POLICY_MODULE = CONFIG.get("DE_POLICY_MODULE", "/usr/local/sbin/de-policy")
SEEN_SECONDS = int(CONFIG.get("DE_TRAFFIC_SEEN_SECONDS", "300"))

FILTER_ON = CONFIG.get("DE_FILTER", "0") == "1"
CA_DIR = CONFIG.get("DE_CA_DIR", "/var/lib/digital-examen/ca")
CA_CERT = os.path.join(CA_DIR, "ca.crt")
CA_KEY = os.path.join(CA_DIR, "ca.key")
NO_OPEN_FILE = CONFIG.get("DE_NO_OPEN_FILE", "/etc/digital-examen/no-open.txt")
NO_OPEN = de_patterns.read_list(NO_OPEN_FILE)

WATCH_ON = CONFIG.get("DE_WATCH", "1") == "1"

SEEN = {}
SEEN_LOCK = threading.Lock()


def load_policy_module():
    spec = importlib.util.spec_from_loader("de_policy", loader=None)
    module = importlib.util.module_from_spec(spec)
    try:
        source = open(POLICY_MODULE).read()
    except IOError:
        return None
    exec(compile(source, POLICY_MODULE, "exec"), module.__dict__)
    return module


POLICY = load_policy_module()


BLOCKED_BODY = "Закрыто ограничениями школы\n".encode("utf-8")
BLOCKED = (
    b"HTTP/1.1 403 Forbidden\r\n"
    b"Content-Type: text/plain; charset=utf-8\r\n"
    b"Content-Length: " + str(len(BLOCKED_BODY)).encode() + b"\r\n"
    b"Connection: close\r\n\r\n" + BLOCKED_BODY
)


def url_from_head(head):
    first = head.split("\r\n", 1)[0].split(" ")
    if len(first) < 2:
        return ""
    return first[1][:600]


def host_from_head(head):
    """Имя узла из первой строки запроса: CONNECT узел:порт или абсолютный адрес."""
    try:
        line = head.split(b"\r\n", 1)[0].decode("latin-1")
    except (IndexError, UnicodeDecodeError):
        return ""

    parts = line.split()
    if len(parts) < 2:
        return ""

    target = parts[1]
    if parts[0].upper() == "CONNECT":
        return target.rsplit(":", 1)[0].strip("[]")

    if "://" in target:
        target = target.split("://", 1)[1]
    target = target.split("/", 1)[0]
    if "@" in target:
        target = target.rsplit("@", 1)[1]
    if target.startswith("["):
        return target[1:].split("]", 1)[0]
    return target.rsplit(":", 1)[0] if target.count(":") == 1 else target


def note_alarm(host, login, found):
    """Сообщить на сайт о подозрительном поведении соединения.

    Это наблюдение, а не запрет: соединение продолжает работать, а на
    сайте появляется запись с признаками, по которым мы сработали.
    """
    record = {
        "kind": "alarm",
        "value": host + " — " + "; ".join(found),
        "at": int(time.time()),
        "login": login,
    }
    try:
        client = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        client.sendto(json.dumps(record).encode(), TRAFFIC_SOCKET)
        client.close()
    except OSError:
        pass


def watch(host, login, **counts):
    if not WATCH_ON or not host:
        return
    row = de_watch.note(host, login, **counts)
    told, found = de_watch.check(row)
    if told:
        note_alarm(told, login, found)


def note_block(host, login, group):
    record = {
        "kind": "block",
        "value": host + " — " + group if group else host,
        "at": int(time.time()),
        "login": login,
    }
    try:
        client = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        client.sendto(json.dumps(record).encode(), TRAFFIC_SOCKET)
        client.close()
    except OSError:
        pass


def warn_user(host, group):
    text = "Сайт %s закрыт ограничениями школы" % host
    if group:
        text += " (%s)" % group
    subprocess.Popen(
        ["notify-send", "Цифровой экзамен", text],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )


def note_visit(host, login):
    """Записать домен один раз в пять минут.

    Пишется только имя узла, без адреса, запроса и тела: подгружаемые
    картинки и скрипты смысла в журнале не несут, а места занимают больше
    всего. Строка выходит около сорока байт.
    """
    if not host or not login:
        return

    key = login + "|" + host
    now = time.time()
    with SEEN_LOCK:
        last = SEEN.get(key, 0)
        if now - last < SEEN_SECONDS:
            return
        SEEN[key] = now
        if len(SEEN) > 20000:
            for old in [name for name, stamp in SEEN.items() if now - stamp > SEEN_SECONDS]:
                SEEN.pop(old, None)

    record = {"kind": "site", "value": host, "at": int(now), "login": login}
    try:
        client = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
        client.sendto(json.dumps(record).encode(), TRAFFIC_SOCKET)
        client.close()
    except OSError:
        pass


def read_secret():
    if not os.path.exists(SECRET_FILE):
        return ""
    return open(SECRET_FILE).read().strip()


def read_login():
    if LOGIN:
        return LOGIN
    if not os.path.exists(LOGIN_FILE):
        return ""
    return open(LOGIN_FILE).read().strip()


def credentials():
    login = read_login()
    secret = read_secret()
    if not login or not secret:
        return ""
    pair = (login + ":" + secret).encode()
    return base64.b64encode(pair).decode()


def connect_upstream():
    last = None
    for host in (UP_HOST, UP_FALLBACK):
        if not host:
            continue
        try:
            return socket.create_connection((host, UP_PORT), timeout=10)
        except OSError as error:
            last = error
    raise last if last else OSError("no upstream configured")


def rewrite_head(head, token):
    lines = head.split(b"\r\n")
    kept = [lines[0]]
    for line in lines[1:]:
        if line.lower().startswith(b"proxy-authorization:"):
            continue
        if line.lower().startswith(b"proxy-connection:"):
            continue
        kept.append(line)
    kept.insert(1, b"Proxy-Authorization: Basic " + token.encode())
    return b"\r\n".join(kept)


def filter_ready():
    """Можно ли вскрывать: включено, есть центр и есть список исключений."""
    if not FILTER_ON:
        return False
    if not NO_OPEN:
        return False
    return os.path.exists(CA_CERT) and os.path.exists(CA_KEY)


def opening_allowed(host):
    """Этот узел вскрываем или пропускаем, не заглядывая внутрь.

    Пустой список «не вскрывать» означает, что файла нет или его не
    прочитали. Вскрывать в этом случае НИЧЕГО нельзя: иначе пропажа одного
    файла превращается в расшифровку банка и госуслуг.
    """
    if not host or not NO_OPEN:
        return False
    return not de_patterns.any_match(NO_OPEN, host)


def look_at(login):
    """Проверка страницы для фильтра: адрес, заголовок и текст."""
    def decide(url, title, text):
        if POLICY is None:
            return "pass"
        host = url.split("://", 1)[-1].split("/", 1)[0]
        verdict = POLICY.decide(host, login, POLICY.read_policy(POLICY_FILE),
                                url=url, title=title, text=text)
        if verdict[0] == "block":
            if verdict[2]:
                note_block(host, login, verdict[1])
                warn_user(host, verdict[1])
            return "block"
        return "pass"
    return decide


def pipe(source, target, counter=None, side=""):
    """Перелить байты и, если просят, посчитать их.

    Счёт нужен присмотру за туннелями: он смотрит, сколько прошло в каждую
    сторону и сколько соединение прожило.
    """
    moved = 0
    try:
        while True:
            chunk = source.recv(65536)
            if not chunk:
                break
            target.sendall(chunk)
            moved += len(chunk)
    except OSError:
        pass
    if counter is not None:
        counter[side] = counter.get(side, 0) + moved
    try:
        target.shutdown(socket.SHUT_WR)
    except OSError:
        pass


def port_from_head(head):
    try:
        line = head.split(b"\r\n", 1)[0].decode("latin-1")
    except (IndexError, UnicodeDecodeError):
        return 443
    parts = line.split()
    if len(parts) < 2 or parts[0].upper() != "CONNECT":
        return 443
    tail = parts[1].rsplit(":", 1)
    return int(tail[1]) if len(tail) == 2 and tail[1].isdigit() else 443


def is_connect(head):
    return head[:8].upper().startswith(b"CONNECT")


def open_inside(client, upstream, host, login):
    """Дождаться ответа школьного прокси и встать в середину соединения.

    Ответ «200 Connection established» от школьного прокси надо снять с
    сокета до того, как начнётся TLS: иначе он попадёт в рукопожатие.
    Ответ, отличный от 200, передаём браузеру как есть.
    """
    answer = b""
    try:
        while b"\r\n\r\n" not in answer:
            chunk = upstream.recv(4096)
            if not chunk:
                return False
            answer += chunk
            if len(answer) > 8192:
                return False
    except OSError:
        return False

    if b" 200 " not in answer.split(b"\r\n", 1)[0]:
        try:
            client.sendall(answer)
        except OSError:
            pass
        return True

    try:
        client.sendall(b"HTTP/1.1 200 Connection established\r\n\r\n")
    except OSError:
        return True

    tally = {}

    def count(what, how_many):
        tally[what] = tally.get(what, 0) + how_many

    started = time.time()
    try:
        return de_filter.open_and_watch(client, host, 443, upstream,
                                        CA_CERT, CA_KEY, look_at(login), count)
    except Exception:
        return True
    finally:
        watch(host, login,
              pages=tally.get("page", 0),
              requests=tally.get("request", 0),
              streams=tally.get("stream", 0),
              seconds=time.time() - started)


class Handler(socketserver.BaseRequestHandler):

    def handle(self):
        client = self.request
        client.settimeout(30)

        head = b""
        while b"\r\n\r\n" not in head:
            chunk = client.recv(4096)
            if not chunk:
                return
            head += chunk
            if len(head) > 65536:
                return

        token = credentials()
        if not token:
            client.sendall(b"HTTP/1.1 503 Service Unavailable\r\nContent-Length: 0\r\n\r\n")
            return

        split = head.index(b"\r\n\r\n")
        rest = head[split + 4:]

        login = read_login()
        host = host_from_head(head[:split])
        note_visit(host, login)

        if POLICY is not None and host:
            verdict = POLICY.decide(host, login, POLICY.read_policy(POLICY_FILE),
                                    url=url_from_head(head[:split]))
            if verdict[0] == "block":
                if verdict[2]:
                    note_block(host, login, verdict[1])
                    warn_user(host, verdict[1])
                client.sendall(BLOCKED)
                return

        new_head = rewrite_head(head[:split], token)

        try:
            upstream = connect_upstream()
        except OSError:
            client.sendall(b"HTTP/1.1 502 Bad Gateway\r\nContent-Length: 0\r\n\r\n")
            return

        upstream.settimeout(None)
        client.settimeout(None)

        try:
            upstream.sendall(new_head + b"\r\n\r\n" + rest)
        except OSError:
            upstream.close()
            return

        if is_connect(head[:split]) and filter_ready() and opening_allowed(host):
            if open_inside(client, upstream, host, login):
                upstream.close()
                return

        counter = {}
        started = time.time()

        first = threading.Thread(target=pipe, args=(client, upstream, counter, "up"))
        first.daemon = True
        first.start()
        pipe(upstream, client, counter, "down")
        first.join(timeout=5)
        upstream.close()

        watch(host, login,
              port=port_from_head(head[:split]),
              up=counter.get("up", 0),
              down=counter.get("down", 0),
              seconds=time.time() - started)


class Server(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    daemon_threads = True


Server((HOST_IP, PORT), Handler).serve_forever()
