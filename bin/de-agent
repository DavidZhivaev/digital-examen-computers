#!/usr/bin/python3

import json
import os
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

CONFIG_FILE = "/etc/digital-examen/computers.conf"
LOGIN_FILE = "/run/digital-examen/current-login"


def read_config():
    values = {}
    if not os.path.exists(CONFIG_FILE):
        return values
    data = open(CONFIG_FILE)
    for line in data:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        name, value = line.split("=", 1)
        value = value.strip()
        if len(value) > 1 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        values[name.strip()] = value
    data.close()
    return values


CONFIG = read_config()
URL = CONFIG.get("DE_SCREEN_URL", "")
SECRET_FILE = CONFIG.get("DE_PROXY_SECRET_FILE", "/etc/digital-examen/proxy.secret")
MODE_FILE = CONFIG.get("DE_SCREEN_MODE_FILE", "/run/digital-examen/screen-mode")
WAIT = int(CONFIG.get("DE_AGENT_WAIT", "25"))
ALLOW_EXEC = CONFIG.get("DE_AGENT_ALLOW_EXEC", "1") == "1"
EXEC_TIMEOUT = int(CONFIG.get("DE_AGENT_EXEC_TIMEOUT", "30"))
EXEC_SHELL = CONFIG.get("DE_AGENT_EXEC_SHELL", "/bin/sh")
LOG = CONFIG.get("DE_LOG_FILE", "/var/log/digital-examen-computers.log")


def log(message):
    stamp = time.strftime("%Y-%m-%d %H:%M:%S")
    try:
        out = open(LOG, "a")
        out.write(stamp + " de-agent " + message + "\n")
        out.close()
    except IOError:
        pass


def read_secret():
    if not os.path.exists(SECRET_FILE):
        return ""
    return open(SECRET_FILE).read().strip()


def read_login():
    if not os.path.exists(LOGIN_FILE):
        return ""
    return open(LOGIN_FILE).read().strip()


def write_mode(value):
    os.makedirs(os.path.dirname(MODE_FILE), exist_ok=True)
    out = open(MODE_FILE, "w")
    out.write(str(int(value)) + "\n")
    out.close()
    os.chmod(MODE_FILE, 0o644)


def ask(login):
    url = URL.rstrip("/") + "/commands?login=" + urllib.parse.quote(login) + "&wait=" + str(WAIT)
    request = urllib.request.Request(url)
    request.add_header("X-De-Login", login)
    request.add_header("X-De-Secret", read_secret())
    answer = urllib.request.urlopen(request, timeout=WAIT + 15)
    return json.loads(answer.read().decode("utf-8"))


def notify(text):
    subprocess.call(
        ["notify-send", "Цифровой экзамен", text],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )


def send_result(command, code, output):
    body = json.dumps({
        "id": command.get("id"),
        "login": read_login(),
        "host": socket.gethostname(),
        "name": command.get("name", ""),
        "code": code,
        "output": output[:20000],
        "time": int(time.time()),
    }).encode()

    request = urllib.request.Request(URL.rstrip("/") + "/result", data=body)
    request.add_header("Content-Type", "application/json")
    request.add_header("X-De-Secret", read_secret())
    try:
        urllib.request.urlopen(request, timeout=20)
    except (urllib.error.URLError, urllib.error.HTTPError, OSError):
        log("result not delivered for " + str(command.get("id")))


def run_shell(line):
    try:
        process = subprocess.Popen(
            [EXEC_SHELL, "-c", line],
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        )
        output = process.communicate(timeout=EXEC_TIMEOUT)[0]
        return process.returncode, output.decode("utf-8", "replace")
    except subprocess.TimeoutExpired:
        process.kill()
        return 124, "превышено время выполнения"
    except OSError as error:
        return 1, str(error)


def apply(command):
    name = command.get("name", "")

    if name == "live":
        write_mode(command.get("interval", 1))
        log("live mode interval " + str(command.get("interval", 1)))
        return

    if name == "archive":
        write_mode(0)
        log("back to archive mode")
        return

    if name == "message":
        notify(str(command.get("text", "")))
        log("message shown")
        send_result(command, 0, "показано")
        return

    if name == "exec":
        line = str(command.get("text", ""))
        if not ALLOW_EXEC:
            log("exec refused by config")
            send_result(command, 126, "выполнение команд запрещено в конфигурации")
            return
        log("exec: " + line[:200])
        code, output = run_shell(line)
        send_result(command, code, output)
        return

    if name == "shutdown":
        delay = str(command.get("delay", "now"))
        log("shutdown " + delay)
        send_result(command, 0, "выключение " + delay)
        subprocess.Popen(["/usr/sbin/shutdown", "-h", delay])
        return

    if name == "reboot":
        delay = str(command.get("delay", "now"))
        log("reboot " + delay)
        send_result(command, 0, "перезагрузка " + delay)
        subprocess.Popen(["/usr/sbin/shutdown", "-r", delay])
        return

    if name == "logout":
        login = read_login()
        log("logout " + login)
        send_result(command, 0, "выход из сеанса " + login)
        subprocess.Popen(["loginctl", "terminate-user", login])
        return

    log("unknown command " + name)
    send_result(command, 127, "неизвестная команда " + name)


def main():
    if not URL:
        return 0

    write_mode(0)

    while True:
        login = read_login()
        if not login:
            time.sleep(5)
            continue

        try:
            answer = ask(login)
        except (urllib.error.URLError, urllib.error.HTTPError, OSError, ValueError):
            time.sleep(10)
            continue

        for command in answer.get("commands", []):
            apply(command)


sys.exit(main())
