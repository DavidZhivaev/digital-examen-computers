#!/usr/bin/python3

import json
import os
import pwd
import socket
import subprocess
import sys
import signal
import threading
import time
import urllib.error
import urllib.parse
import urllib.request

sys.path.insert(0, "/usr/local/lib/digital-examen")

import de_common
import de_control
import de_inspection
import de_learned
import de_lesson_activity
import de_network_events
import de_mass_commands
import de_tabs

URL = de_common.setting("DE_SCREEN_URL")
API = de_common.setting("DE_API_URL")
COMPUTER = de_common.computer()
MODE_FILE = os.path.join(de_common.RUN_DIR, "screen-mode")
POLICY_FILE = os.path.join(de_common.STATE_DIR, "policy.json")
WAIT = 25
EXEC_TIMEOUT = int(de_common.setting("DE_AGENT_EXEC_TIMEOUT", "30"))
STATS_INTERVAL = 5
HEARTBEAT_INTERVAL = 6
COMMAND_SIGNAL = threading.Event()


def log(message):
    de_common.log("de-agent", message)


def write_mode(value):
    de_common.write_file(MODE_FILE, str(int(value)) + "\n")


def ask():
    url = (URL.rstrip("/") + "/commands?computer=" + urllib.parse.quote(COMPUTER)
           + "&wait=" + str(WAIT))
    request = urllib.request.Request(url)
    request.add_header("X-De-Computer", COMPUTER)
    request.add_header("X-De-Secret", de_common.secret("screen"))
    answer = urllib.request.urlopen(request, timeout=WAIT + 15)
    return json.loads(answer.read().decode("utf-8"))


def send_result(command, code, output):
    if not command.get("id"):
        return
    try:
        de_common.send_json(URL.rstrip("/") + "/result", {
            "id": command.get("id"),
            "computer": COMPUTER,
            "login": de_common.current_user(),
            "host": socket.gethostname(),
            "name": command.get("name", ""),
            "code": code,
            "output": output[:20000],
            "time": int(time.time()),
        }, "screen")
    except (OSError, ValueError):
        log("ответ не доставлен для " + str(command.get("id")))


def run_shell(line):
    return de_common.run(["/bin/sh", "-c", line], EXEC_TIMEOUT)


def save_policy(policy):
    if not isinstance(policy, dict):
        return
    text = json.dumps(policy, sort_keys=True)
    if de_common.read_file(POLICY_FILE) != text:
        de_common.write_file(POLICY_FILE, text)
        log("политика ограничений обновлена")
    if policy.get("groups"):
        de_common.write_file(os.path.join(de_common.RUN_DIR, "network-owned"), "1", 0o600)


def power(action):
    time.sleep(1)
    subprocess.call(["systemctl", action, "-i"])


def apply(command):
    name = command.get("name", "")

    if name == "live":
        write_mode(command.get("interval", 1))
        return

    if name == "archive":
        write_mode(0)
        return

    if name == "policy":
        save_policy(command.get("policy", {}))
        return

    if name == "close-tab":
        session = de_common.screen_session()
        closed = bool(session and de_tabs.close(str(command.get("tab", "")), session["Id"]))
        send_result(command, 0 if closed else 1, "" if closed else "Вкладка уже закрыта или изменилась")
        return

    if name == "exec":
        line = str(command.get("text", ""))
        log("exec: " + line[:200])
        code, output = run_shell(line)
        send_result(command, code, output)
        return

    if name in ("shutdown", "reboot"):
        action = "poweroff" if name == "shutdown" else "reboot"
        log("команда " + action)
        send_result(command, 0, action)
        threading.Thread(target=power, args=(action,)).start()
        return

    send_result(command, 127, "неизвестная команда " + name)


def disk_numbers():
    try:
        info = os.statvfs("/")
    except OSError:
        return None, None
    return info.f_bavail * info.f_frsize, info.f_blocks * info.f_frsize


def memory_numbers():
    total = None
    available = None
    try:
        for line in open("/proc/meminfo"):
            if line.startswith("MemTotal:"):
                total = int(line.split()[1]) * 1024
            if line.startswith("MemAvailable:"):
                available = int(line.split()[1]) * 1024
    except (IOError, ValueError, IndexError):
        return None, None
    return available, total


def cpu_sample():
    try:
        numbers = [int(item) for item in open("/proc/stat").readline().split()[1:]]
    except (IOError, ValueError):
        return None
    idle = numbers[3] + numbers[4]
    return sum(numbers), idle


def network_bytes():
    device = de_network_events.active_interface()
    if device:
        try:
            return device, de_network_events.interface_bytes(device)
        except (OSError, ValueError):
            pass
    return None


def first_number(path):
    try:
        return float(open(path).read().split()[0])
    except (IOError, ValueError, IndexError):
        return None


def stats_loop():
    previous_cpu = cpu_sample()
    previous_net = network_bytes()
    previous_time = time.time()
    previous_identity = None

    while True:
        time.sleep(STATS_INTERVAL)
        free_disk, total_disk = disk_numbers()
        free_memory, total_memory = memory_numbers()

        current_cpu = cpu_sample()
        percent = None
        if previous_cpu and current_cpu and current_cpu[0] != previous_cpu[0]:
            busy = (current_cpu[0] - previous_cpu[0]) - (current_cpu[1] - previous_cpu[1])
            percent = 100.0 * busy / (current_cpu[0] - previous_cpu[0])
        previous_cpu = current_cpu

        current_net = network_bytes()
        now = time.time()
        kbits = None
        if (previous_net and current_net and current_net[0] == previous_net[0]
                and current_net[1] >= previous_net[1] and now > previous_time):
            kbits = (current_net[1] - previous_net[1]) * 8.0 / 1000.0 / (now - previous_time)
        previous_net = current_net
        previous_time = now

        session = de_common.screen_session()
        login = session.get("Name", "") if session and session.get("Class") != "greeter" else ""
        identity = None
        if login:
            try:
                identity = (pwd.getpwnam(login).pw_uid, session["Id"])
            except KeyError:
                pass
        try:
            policy = json.loads(de_common.read_file(POLICY_FILE) or "{}")
            groups = [] if (de_control.RUN / "block-off").exists() else policy.get("groups", [])
            rules = list(dict.fromkeys(rule for group in groups for rule in group.get("tab_titles", [])))
            url_groups = [{"allow": [], "deny": [], "domains": list(de_inspection.PERMANENT_ALLOW)}]
            url_groups += [{
                "allow": group.get("url_allow", []),
                "deny": [],
                "domains": group.get("always_allow", []),
            } for group in groups
                if group.get("url_allow") or group.get("always_allow")]
        except (ValueError, TypeError):
            rules, url_groups, groups = [], [], []
        admin = login and de_common.is_admin(login)
        de_lesson_activity.active = bool(identity and session.get("LockedHint") != "yes")
        if admin and identity and identity != previous_identity:
            de_lesson_activity.mark_privileged()
        previous_identity = identity
        de_tabs.activate(identity, None if admin else rules, [] if admin else url_groups, bool(groups) and not admin)

        uptime = first_number("/proc/uptime")
        try:
            de_common.send_json(URL.rstrip("/") + "/stats", {
                "computer": COMPUTER,
                "disk_free": free_disk,
                "disk_total": total_disk,
                "memory_free": free_memory,
                "memory_total": total_memory,
                "cpu_percent": percent,
                "network_kbits": kbits,
                "uptime": int(uptime) if uptime is not None else None,
                "load_average": first_number("/proc/loadavg"),
                "login": login,
                "tabs": de_tabs.list_tabs(),
            }, "screen", 10)
        except (OSError, ValueError):
            pass


def save_heartbeat_policy(answer):
    policy = answer.get("policy")
    if isinstance(policy, dict):
        enabled = "0" if policy.get("screen_enabled") is False else "1"
        if de_common.read_file(de_common.SCREEN_ENABLED_FILE) != enabled:
            de_common.write_file(de_common.SCREEN_ENABLED_FILE, enabled)
        save_policy(policy)


def heartbeat_loop():
    boot = next((int(line.split()[1]) for line in de_common.read_file("/proc/stat").splitlines()
                 if line.startswith("btime ")), None)
    last_conflict = ""
    while True:
        deadline = time.monotonic() + HEARTBEAT_INTERVAL
        hostname = socket.gethostname()
        place = de_common.hostname_place(hostname)
        target = de_common.place_name(place) if place else COMPUTER
        moved = target != COMPUTER
        url = API.rstrip("/") + "/api/computers/device/heartbeat"
        payload = {"computer": COMPUTER, "online": True, "login": de_common.current_user(),
                   "boot": boot, "command_jobs": True}
        network = de_network_events.snapshot(time.time())
        if network is not None:
            payload["network"] = network
        report = de_lesson_activity.snapshot(time.time())
        if report:
            payload["lesson_activity"] = report[0]
        if place:
            payload.update(hostname=hostname, sync_screen=moved)
        try:
            try:
                answer = de_common.send_json(url, payload, "proxy", HEARTBEAT_INTERVAL)
            except urllib.error.HTTPError as error:
                if moved and error.code == 409:
                    if target != last_conflict:
                        log("место %s занято. Удалите прежнее устройство в настройках кабинета" % target)
                        last_conflict = target
                    payload.pop("hostname", None)
                    answer = de_common.send_json(url, payload, "proxy", HEARTBEAT_INTERVAL)
                    save_heartbeat_policy(answer)
                    time.sleep(max(0, deadline - time.monotonic()))
                    continue
                if not moved or error.code != 403:
                    raise
                payload["computer"] = target
                answer = de_common.send_json(url, payload, "proxy", HEARTBEAT_INTERVAL, identity=target)
            if answer.get("remove_agent") is True and answer.get("computer") == COMPUTER:
                subprocess.run([
                    "systemd-run", "--unit=de-agent-removal", "--collect", "/bin/sh",
                    "/opt/digital-examen-computers/delete.sh",
                ], check=True)
                return
            de_lesson_activity.configure(answer.get("lesson_start"))
            if network is not None and answer.get("network_saved"):
                de_network_events.acknowledge(network)
            if report:
                de_lesson_activity.acknowledged(report)
            save_heartbeat_policy(answer)
            if answer.get("command_pending") is True:
                COMMAND_SIGNAL.set()
            last_conflict = ""
            if moved and answer.get("computer") == target and answer.get("screen_ready"):
                de_common.write_place(target, place)
                log("регистрация перенесена в " + target)
                subprocess.run(
                    ["systemctl", "--no-block", "restart", "de-agent.service",
                     "de-screen.service", "de-net.service", "de-traffic.service"],
                    check=True,
                )
                return
        except urllib.error.HTTPError as error:
            if error.code in (403, 404):
                if de_common.read_file(de_common.SCREEN_ENABLED_FILE) != "0":
                    de_common.write_file(de_common.SCREEN_ENABLED_FILE, "0")
        except (OSError, ValueError, subprocess.CalledProcessError):
            pass
        time.sleep(max(0, deadline - time.monotonic()))


def command_jobs_loop():
    endpoint = API.rstrip("/") + "/api/computers/device/command-jobs/"
    result = None
    while True:
        if result is None:
            COMMAND_SIGNAL.wait()
            COMMAND_SIGNAL.clear()
        try:
            if result is not None:
                de_common.send_json(endpoint + "result", result, "proxy", 10)
                result = None
            job = de_common.send_json(endpoint + "next", {}, "proxy", 10)
            if job.get("id"):
                command = str(job.get("command", ""))
                try:
                    code, output = de_mass_commands.execute(command, int(job["id"]))
                except (OSError, ValueError) as error:
                    code, output = 1, str(error)
                if code is not None:
                    result = {"target_id": job["id"], "code": code if 0 <= code <= 255 else 1,
                              "awaiting_reboot": command == "reboot" and code == 0,
                              "output": output.replace("\0", "")[:20000]}
                continue
        except urllib.error.HTTPError as error:
            if error.code in (403, 404, 422):
                result = None
        except (OSError, ValueError):
            pass
        time.sleep(10)



def learned_loop():
    endpoint = API.rstrip("/") + "/api/computers/device/learned-blocks"
    while True:
        try:
            records = [(url, term, expires - 86400) for url, terms in de_learned.active().items()
                       for term, expires in terms.items()]
            answer = de_common.send_json(endpoint, {"observations": records[-256:]}, "proxy", 15)
            if isinstance(answer.get("blocks"), dict):
                de_learned.write(de_learned.SHARED, answer["blocks"])
        except (OSError, ValueError):
            pass
        time.sleep(1800)


def main():
    threading.Thread(target=de_control.listen, daemon=True).start()
    if not URL or not COMPUTER:
        log("компьютер не на учёте, агент ждёт")
        time.sleep(300)
        return 0

    write_mode(0)
    threading.Thread(target=de_tabs.listen, daemon=True).start()
    threading.Thread(target=de_lesson_activity.listen, daemon=True).start()
    threading.Thread(target=de_network_events.monitor, daemon=True).start()
    threading.Thread(target=stats_loop, daemon=True).start()
    if API:
        threading.Thread(target=heartbeat_loop, daemon=True).start()
        threading.Thread(target=learned_loop, daemon=True).start()
        threading.Thread(target=command_jobs_loop, daemon=True).start()

    while True:
        try:
            answer = ask()
        except (OSError, ValueError):
            time.sleep(5)
            continue

        if answer.get("interval") is not None:
            write_mode(answer.get("interval") or 0)

        for command in answer.get("commands", []):
            try:
                apply(command)
            except Exception as error:
                log("команда %s не выполнена: %s" % (command.get("name"), error))


def stop(_signum, _frame):
    raise SystemExit(0)


signal.signal(signal.SIGTERM, stop)
try:
    sys.exit(main())
finally:
    de_lesson_activity.checkpoint()
