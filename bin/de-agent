#!/usr/bin/python3

import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

CONFIG_FILE = "/etc/digital-examen/computers.conf"
LOGIN_FILE = "/run/digital-examen/current-login"


def read_config():
    values = {}
    if not os.path.exists(CONFIG_FILE):
        return values
    data = open(CONFIG_FILE)
    for line in data:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        name, value = line.split("=", 1)
        value = value.strip()
        if len(value) > 1 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        values[name.strip()] = value
    data.close()
    return values


CONFIG = read_config()
URL = CONFIG.get("DE_SCREEN_URL", "")
SECRET_FILE = CONFIG.get("DE_PROXY_SECRET_FILE", "/etc/digital-examen/proxy.secret")
MODE_FILE = CONFIG.get("DE_SCREEN_MODE_FILE", "/run/digital-examen/screen-mode")
WAIT = int(CONFIG.get("DE_AGENT_WAIT", "25"))
LOG = CONFIG.get("DE_LOG_FILE", "/var/log/digital-examen-computers.log")


def log(message):
    stamp = time.strftime("%Y-%m-%d %H:%M:%S")
    try:
        out = open(LOG, "a")
        out.write(stamp + " de-agent " + message + "\n")
        out.close()
    except IOError:
        pass


def read_secret():
    if not os.path.exists(SECRET_FILE):
        return ""
    return open(SECRET_FILE).read().strip()


def read_login():
    if not os.path.exists(LOGIN_FILE):
        return ""
    return open(LOGIN_FILE).read().strip()


def write_mode(value):
    os.makedirs(os.path.dirname(MODE_FILE), exist_ok=True)
    out = open(MODE_FILE, "w")
    out.write(str(int(value)) + "\n")
    out.close()
    os.chmod(MODE_FILE, 0o644)


def ask(login):
    url = URL.rstrip("/") + "/commands?login=" + urllib.parse.quote(login) + "&wait=" + str(WAIT)
    request = urllib.request.Request(url)
    request.add_header("X-De-Login", login)
    request.add_header("X-De-Secret", read_secret())
    answer = urllib.request.urlopen(request, timeout=WAIT + 15)
    return json.loads(answer.read().decode("utf-8"))


def notify(text):
    subprocess.call(
        ["notify-send", "Цифровой экзамен", text],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )


def apply(command):
    name = command.get("name", "")

    if name == "live":
        write_mode(command.get("interval", 1))
        log("live mode interval " + str(command.get("interval", 1)))
        return

    if name == "archive":
        write_mode(0)
        log("back to archive mode")
        return

    if name == "message":
        notify(str(command.get("text", "")))
        log("message shown")
        return

    log("unknown command " + name)


def main():
    if not URL:
        return 0

    write_mode(0)

    while True:
        login = read_login()
        if not login:
            time.sleep(5)
            continue

        try:
            answer = ask(login)
        except (urllib.error.URLError, urllib.error.HTTPError, OSError, ValueError):
            time.sleep(10)
            continue

        for command in answer.get("commands", []):
            apply(command)


sys.exit(main())
