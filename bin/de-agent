#!/usr/bin/python3

import json
import os
import socket
import ssl
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request

CONFIG_FILE = "/etc/digital-examen/computers.conf"
LOGIN_FILE = "/run/digital-examen/current-login"


def read_config():
    values = {}
    if not os.path.exists(CONFIG_FILE):
        return values
    data = open(CONFIG_FILE)
    for line in data:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        name, value = line.split("=", 1)
        value = value.strip()
        if len(value) > 1 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        values[name.strip()] = value
    data.close()
    return values


CONFIG = read_config()
URL = CONFIG.get("DE_SCREEN_URL", "")
API = CONFIG.get("DE_API_URL", "")
COMPUTER = CONFIG.get("DE_COMPUTER_ID", "")
SECRET_FILE = CONFIG.get("DE_SCREEN_SECRET_FILE", CONFIG.get("DE_PROXY_SECRET_FILE", "/etc/digital-examen/proxy.secret"))
MODE_FILE = CONFIG.get("DE_SCREEN_MODE_FILE", "/run/digital-examen/screen-mode")
POLICY_FILE = CONFIG.get("DE_POLICY_FILE", "/run/digital-examen/policy.json")

WAIT = int(CONFIG.get("DE_AGENT_WAIT", "25"))
ALLOW_EXEC = CONFIG.get("DE_AGENT_ALLOW_EXEC", "1") == "1"
EXEC_TIMEOUT = int(CONFIG.get("DE_AGENT_EXEC_TIMEOUT", "30"))
EXEC_SHELL = CONFIG.get("DE_AGENT_EXEC_SHELL", "/bin/sh")
STATS_INTERVAL = int(CONFIG.get("DE_STATS_INTERVAL", "5"))
HEARTBEAT_INTERVAL = int(CONFIG.get("DE_HEARTBEAT_INTERVAL", "30"))
LOG = CONFIG.get("DE_LOG_FILE", "/var/log/digital-examen-computers.log")


def build_opener():
    ca = CONFIG.get("DE_SCREEN_CA", "")
    if not ca or not os.path.exists(ca):
        return urllib.request.build_opener()
    context = ssl.create_default_context(cafile=ca)
    context.check_hostname = True
    context.verify_mode = ssl.CERT_REQUIRED
    return urllib.request.build_opener(urllib.request.HTTPSHandler(context=context))


OPENER = build_opener()


def log(message):
    stamp = time.strftime("%Y-%m-%d %H:%M:%S")
    try:
        out = open(LOG, "a")
        out.write(stamp + " de-agent " + message + "\n")
        out.close()
    except IOError:
        pass


def read_file(path):
    if not os.path.exists(path):
        return ""
    return open(path).read().strip()


def write_mode(value):
    os.makedirs(os.path.dirname(MODE_FILE), exist_ok=True)
    out = open(MODE_FILE, "w")
    out.write(str(int(value)) + "\n")
    out.close()
    os.chmod(MODE_FILE, 0o644)


def ask():
    url = (URL.rstrip("/") + "/commands?computer=" + urllib.parse.quote(COMPUTER)
           + "&wait=" + str(WAIT))
    request = urllib.request.Request(url)
    request.add_header("X-De-Computer", COMPUTER)
    request.add_header("X-De-Secret", read_file(SECRET_FILE))
    answer = OPENER.open(request, timeout=WAIT + 15)
    return json.loads(answer.read().decode("utf-8"))


def post(url, payload, timeout=20):
    request = urllib.request.Request(url, data=json.dumps(payload).encode())
    request.add_header("Content-Type", "application/json")
    request.add_header("X-De-Computer", COMPUTER)
    request.add_header("X-De-Secret", read_file(SECRET_FILE))
    answer = OPENER.open(request, timeout=timeout)
    return json.loads(answer.read().decode("utf-8"))


def notify(text):
    subprocess.call(
        ["notify-send", "Цифровой экзамен", text],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )


def send_result(command, code, output):
    try:
        post(URL.rstrip("/") + "/result", {
            "id": command.get("id"),
            "computer": COMPUTER,
            "login": read_file(LOGIN_FILE),
            "host": socket.gethostname(),
            "name": command.get("name", ""),
            "code": code,
            "output": output[:20000],
            "time": int(time.time()),
        })
    except (urllib.error.URLError, urllib.error.HTTPError, OSError, ValueError):
        log("ответ не доставлен для " + str(command.get("id")))


def run_shell(line):
    process = None
    try:
        process = subprocess.Popen(
            [EXEC_SHELL, "-c", line],
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        )
        output = process.communicate(timeout=EXEC_TIMEOUT)[0]
        return process.returncode, output.decode("utf-8", "replace")
    except subprocess.TimeoutExpired:
        if process is not None:
            process.kill()
        return 124, "превышено время выполнения"
    except OSError as error:
        return 1, str(error)


def save_policy(policy):
    os.makedirs(os.path.dirname(POLICY_FILE), exist_ok=True)
    temporary = POLICY_FILE + ".new"
    out = open(temporary, "w")
    out.write(json.dumps(policy))
    out.close()
    os.chmod(temporary, 0o644)
    os.replace(temporary, POLICY_FILE)


def apply(command):
    name = command.get("name", "")

    if name == "live":
        write_mode(command.get("interval", 1))
        return

    if name == "archive":
        write_mode(0)
        return

    if name == "policy":
        save_policy(command.get("policy", {}))
        log("политика ограничений обновлена")
        return

    if name == "message":
        notify(str(command.get("text", "")))
        send_result(command, 0, "показано")
        return

    if name == "exec":
        line = str(command.get("text", ""))
        if not ALLOW_EXEC:
            send_result(command, 126, "выполнение команд запрещено в конфигурации")
            return
        log("exec: " + line[:200])
        code, output = run_shell(line)
        send_result(command, code, output)
        return

    if name == "shutdown":
        delay = str(command.get("delay", "now"))
        log("выключение " + delay)
        send_result(command, 0, "выключение " + delay)
        subprocess.Popen(["/usr/sbin/shutdown", "-h", delay])
        return

    if name == "reboot":
        delay = str(command.get("delay", "now"))
        log("перезагрузка " + delay)
        send_result(command, 0, "перезагрузка " + delay)
        subprocess.Popen(["/usr/sbin/shutdown", "-r", delay])
        return

    if name == "logout":
        login = read_file(LOGIN_FILE)
        send_result(command, 0, "выход из сеанса " + login)
        subprocess.Popen(["loginctl", "terminate-user", login])
        return

    log("неизвестная команда " + name)
    send_result(command, 127, "неизвестная команда " + name)


def disk_numbers():
    try:
        info = os.statvfs("/")
    except OSError:
        return None, None
    return info.f_bavail * info.f_frsize, info.f_blocks * info.f_frsize


def memory_numbers():
    total = None
    available = None
    try:
        for line in open("/proc/meminfo"):
            if line.startswith("MemTotal:"):
                total = int(line.split()[1]) * 1024
            if line.startswith("MemAvailable:"):
                available = int(line.split()[1]) * 1024
    except (IOError, ValueError, IndexError):
        return None, None
    return available, total


def cpu_sample():
    try:
        parts = open("/proc/stat").readline().split()[1:]
        numbers = [int(item) for item in parts]
    except (IOError, ValueError, IndexError):
        return None
    idle = numbers[3] + (numbers[4] if len(numbers) > 4 else 0)
    return sum(numbers), idle


def network_bytes():
    total = 0
    try:
        for line in open("/proc/net/dev").readlines()[2:]:
            name, rest = line.split(":", 1)
            if name.strip() in ("lo",):
                continue
            fields = rest.split()
            total += int(fields[0]) + int(fields[8])
    except (IOError, ValueError, IndexError):
        return None
    return total


def uptime_seconds():
    try:
        return int(float(open("/proc/uptime").read().split()[0]))
    except (IOError, ValueError, IndexError):
        return None


def load_average():
    try:
        return float(open("/proc/loadavg").read().split()[0])
    except (IOError, ValueError, IndexError):
        return None


def stats_loop():
    previous_cpu = cpu_sample()
    previous_net = network_bytes()
    previous_time = time.time()

    while True:
        time.sleep(STATS_INTERVAL)

        free_disk, total_disk = disk_numbers()
        free_memory, total_memory = memory_numbers()

        current_cpu = cpu_sample()
        percent = None
        if previous_cpu and current_cpu and current_cpu[0] != previous_cpu[0]:
            busy = (current_cpu[0] - previous_cpu[0]) - (current_cpu[1] - previous_cpu[1])
            percent = 100.0 * busy / (current_cpu[0] - previous_cpu[0])
        previous_cpu = current_cpu

        current_net = network_bytes()
        kbits = None
        now = time.time()
        if previous_net is not None and current_net is not None and now > previous_time:
            kbits = (current_net - previous_net) * 8.0 / 1000.0 / (now - previous_time)
        previous_net = current_net
        previous_time = now

        payload = {
            "computer": COMPUTER,
            "disk_free": free_disk,
            "disk_total": total_disk,
            "memory_free": free_memory,
            "memory_total": total_memory,
            "cpu_percent": percent,
            "network_kbits": kbits,
            "uptime": uptime_seconds(),
            "load_average": load_average(),
        }

        try:
            post(URL.rstrip("/") + "/stats", payload, timeout=10)
        except (urllib.error.URLError, urllib.error.HTTPError, OSError, ValueError):
            pass


def heartbeat_loop():
    while True:
        try:
            post(API.rstrip("/") + "/api/computers/device/heartbeat", {
                "computer": COMPUTER,
                "online": True,
                "login": read_file(LOGIN_FILE),
            }, timeout=15)
        except (urllib.error.URLError, urllib.error.HTTPError, OSError, ValueError):
            pass
        time.sleep(HEARTBEAT_INTERVAL)


def main():
    if not URL or not COMPUTER:
        return 0

    write_mode(0)

    threading.Thread(target=stats_loop, daemon=True).start()
    if API:
        threading.Thread(target=heartbeat_loop, daemon=True).start()

    while True:
        try:
            answer = ask()
        except (urllib.error.URLError, urllib.error.HTTPError, OSError, ValueError):
            time.sleep(10)
            continue

        if answer.get("interval"):
            write_mode(answer["interval"])

        for command in answer.get("commands", []):
            apply(command)


sys.exit(main())
