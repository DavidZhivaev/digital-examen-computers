#!/usr/bin/python3

import hashlib
import json
import os
import socket
import sys
import time
import urllib.error
import urllib.request

sys.path.insert(0, "/usr/local/lib/digital-examen")

import de_users
import de_vault

CONFIG = de_vault.read_config()
ATTEMPT_MARK = "/run/digital-examen/last-attempt.json"

OK = 0
DENY = 1
SKIP = 2


def log(message):
    path = CONFIG.get("DE_LOG_FILE", "/var/log/digital-examen-computers.log")
    stamp = time.strftime("%Y-%m-%d %H:%M:%S")
    try:
        out = open(path, "a")
        out.write(stamp + " de-login-auth " + message + "\n")
        out.close()
    except IOError:
        pass


def note_attempt(login, result):
    try:
        os.makedirs("/run/digital-examen", exist_ok=True)
        out = open(ATTEMPT_MARK, "w")
        out.write(json.dumps({"login": login, "result": result, "time": int(time.time())}))
        out.close()
        os.chmod(ATTEMPT_MARK, 0o600)
    except OSError:
        pass


def read_password():
    data = sys.stdin.buffer.read()
    if data.endswith(b"\x00"):
        data = data[:-1]
    return data.decode("utf-8", "replace").rstrip("\n")


def leading_zero_bits(digest):
    bits = 0
    for byte in digest:
        if byte == 0:
            bits += 8
            continue
        bits += 8 - byte.bit_length()
        break
    return bits


def solve_pow(challenge_id, nonce, difficulty):
    prefix = (challenge_id + nonce).encode()
    number = 0
    while number < 100000000:
        digest = hashlib.sha256(prefix + str(number).encode()).digest()
        if leading_zero_bits(digest) >= difficulty:
            return str(number)
        number += 1
    return None


def post_json(url, body, timeout, headers=None):
    data = json.dumps(body).encode()
    request = urllib.request.Request(url, data=data)
    request.add_header("Content-Type", "application/json")
    request.add_header("User-Agent", "digital-examen-computers")
    for name, value in (headers or {}).items():
        request.add_header(name, value)
    answer = urllib.request.urlopen(request, timeout=timeout)
    return json.loads(answer.read().decode("utf-8"))


def ask_challenge():
    url = CONFIG.get("DE_API_URL", "").rstrip("/") + "/auth/pow/challenge"
    timeout = int(CONFIG.get("DE_API_TIMEOUT", "10"))
    return post_json(url, {"platform": "desktop"}, timeout)


def ask_login(login, password, challenge):
    url = CONFIG.get("DE_API_URL", "").rstrip("/") + "/auth/login"
    timeout = int(CONFIG.get("DE_API_TIMEOUT", "10"))
    device = CONFIG.get("DE_DEVICE_NAME", "")
    if not device:
        device = socket.gethostname()
    body = {
        "login": login,
        "password": password,
        "device_name": device,
        "client_type": "web",
        "pow_challenge_id": challenge["challenge_id"],
        "pow_solution": challenge["solution"],
    }
    return post_json(url, body, timeout)


def ask_informatics(login):
    url = CONFIG.get("DE_API_URL", "").rstrip("/") + "/api/computers/device/person"
    timeout = int(CONFIG.get("DE_API_TIMEOUT", "10"))
    secret = de_vault.read_text(CONFIG.get("DE_PROXY_SECRET_FILE", "/etc/digital-examen/proxy.secret"))
    if not secret:
        return ""
    try:
        answer = post_json(url, {"login": login}, timeout, {"X-De-Secret": secret})
        return str(answer.get("informatics", ""))
    except Exception:
        return ""


def token_payload(token):
    parts = token.split(".")
    if len(parts) != 3:
        return {}
    body = parts[1]
    body = body + "=" * (-len(body) % 4)
    try:
        import base64
        return json.loads(base64.urlsafe_b64decode(body.encode()).decode("utf-8"))
    except Exception:
        return {}


def role_allowed(payload):
    allowed = CONFIG.get("DE_ALLOW_ROLES", "1").split()
    role = payload.get("role")
    if role is None:
        return False
    return str(role) in allowed


def main():
    typed = os.environ.get("PAM_USER", "")

    if not typed:
        return SKIP
    if de_users.user_is_protected(typed, CONFIG):
        return SKIP
    if not CONFIG.get("DE_API_URL"):
        log("no api url in config")
        return SKIP

    canonical = de_users.canonical_name(typed)

    if de_users.user_exists(typed) and not de_users.state_exists(typed):
        return SKIP
    if de_users.user_exists(canonical) and not de_users.state_exists(canonical):
        return SKIP
    if not de_users.login_is_safe(typed, CONFIG):
        log("login rejected by pattern: " + typed)
        return SKIP

    password = read_password()
    if not password:
        return DENY

    try:
        challenge = ask_challenge()
        solution = solve_pow(challenge["challenge_id"], challenge["nonce"], challenge["difficulty"])
        if solution is None:
            log("pow not solved for " + canonical)
            note_attempt(typed, "denied")
            return DENY
        challenge["solution"] = solution
        answer = ask_login(canonical, password, challenge)
    except urllib.error.HTTPError as error:
        log("site refused " + canonical + " http " + str(error.code))
        note_attempt(typed, "denied")
        return DENY
    except (urllib.error.URLError, socket.timeout, OSError, ValueError) as error:
        log("site unreachable for " + canonical + ": " + str(error))
        note_attempt(typed, "unreachable")
        return DENY

    payload = token_payload(answer.get("access_token", ""))
    if not role_allowed(payload):
        log("role not allowed for " + canonical)
        note_attempt(typed, "denied")
        return DENY

    informatics = ask_informatics(canonical)
    done, note = de_users.prepare(CONFIG, typed, password, {
        "user_id": payload.get("sub", ""),
        "person_id": payload.get("person_id", ""),
        "role": payload.get("role", ""),
        "informatics": informatics,
        "offline": "",
    })
    if not done:
        log("не создал пользователя " + canonical + ": " + note)
        note_attempt(typed, "denied")
        return DENY

    note_attempt(typed, "ok")
    log("login ok as " + typed)
    return OK


sys.exit(main())
