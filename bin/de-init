#!/usr/bin/python3

import json
import os
import socket
import ssl
import subprocess
import time
import sys
import urllib.error
import urllib.parse
import urllib.request

sys.path.insert(0, "/usr/local/lib/digital-examen")

import de_keys

CONFIG_FILE = "/etc/digital-examen/computers.conf"


def read_config():
    values = {}
    if not os.path.exists(CONFIG_FILE):
        return values
    data = open(CONFIG_FILE)
    for line in data:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        name, value = line.split("=", 1)
        value = value.strip()
        if len(value) > 1 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        values[name.strip()] = value
    data.close()
    return values


CONFIG = read_config()
API = CONFIG.get("DE_API_URL", "https://as.1580.ru")
PROXY_SECRET_FILE = CONFIG.get("DE_PROXY_SECRET_FILE", "/etc/digital-examen/proxy.secret")
COMMAND_SECRET_FILE = CONFIG.get("DE_COMMAND_SECRET_FILE", "/etc/digital-examen/command.secret")
SCREEN_SECRET_FILE = CONFIG.get("DE_SCREEN_SECRET_FILE", "/etc/digital-examen/screen.secret")
VAULT_SECRET_FILE = CONFIG.get("DE_VAULT_SECRET_FILE", "/etc/digital-examen/vault.secret")
KEY_FILE_NAME = CONFIG.get("DE_KEY_FILE", "de-key.txt")


def say(message):
    sys.stdout.write(message + "\n")
    sys.stdout.flush()


def call(path, payload=None, params=None):
    url = API.rstrip("/") + path
    if params:
        url = url + "?" + urllib.parse.urlencode(params)
    data = json.dumps(payload).encode() if payload is not None else None
    request = urllib.request.Request(url, data=data)
    if data is not None:
        request.add_header("Content-Type", "application/json")
    context = ssl.create_default_context()
    answer = urllib.request.urlopen(request, timeout=25, context=context)
    return json.loads(answer.read().decode("utf-8"))


def wait_for_key():
    """Без ключа администратора компьютер на учёт не ставится.

    Ключ лежит файлом в корне флешки, выдаёт его сайт администратору
    информатики или школы. Права владельца сайт проверяет заново на каждой
    установке, поэтому отобранные права закрывают и установку.
    """
    say("Вставьте флешку с ключом администратора (файл %s)." % KEY_FILE_NAME)
    say("Ключ скачивается на сайте: Компьютеры → Скачать ключ.")
    say("Отмена — Ctrl+C.")
    while True:
        path = de_keys.find_key(KEY_FILE_NAME)
        if path:
            values = de_keys.parse_key(path)
            if values.get("fingerprint") and values.get("secret"):
                say("Ключ найден: %s" % path)
                return values
            say("Файл ключа найден, но в нём нет fingerprint и secret.")
        try:
            time.sleep(3)
        except KeyboardInterrupt:
            return {}


def ask_number(question, low, high):
    while True:
        try:
            raw = input(question + ": ").strip()
        except (EOFError, KeyboardInterrupt):
            return None
        if not raw.isdigit():
            say("Нужно число от %d до %d." % (low, high))
            continue
        value = int(raw)
        if low <= value <= high:
            return value
        say("Нужно число от %d до %d." % (low, high))


def write_secret(path, value):
    if not value:
        return
    folder = os.path.dirname(path)
    if folder:
        os.makedirs(folder, exist_ok=True)
    out = open(path, "w")
    out.write(value + "\n")
    out.close()
    os.chmod(path, 0o600)
    os.chown(path, 0, 0)


def write_config(values):
    lines = []
    seen = set()
    for line in open(CONFIG_FILE):
        key = line.split("=", 1)[0].strip()
        if key in values:
            lines.append('%s="%s"\n' % (key, values[key]))
            seen.add(key)
        else:
            lines.append(line)
    for key, value in values.items():
        if key not in seen:
            lines.append('%s="%s"\n' % (key, value))
    out = open(CONFIG_FILE, "w")
    out.write("".join(lines))
    out.close()
    os.chmod(CONFIG_FILE, 0o640)


def main():
    if os.geteuid() != 0:
        say("Запускать от root.")
        return 1

    if not os.path.exists(CONFIG_FILE):
        say("Нет %s — сначала отработает setup.sh." % CONFIG_FILE)
        return 1

    key = wait_for_key()
    if not key:
        say("Ключ не предъявлен, установка прервана.")
        return 1

    existing = CONFIG.get("DE_COMPUTER_ID", "")
    if existing:
        say("Компьютер уже поставлен на учёт как %s." % existing)
        try:
            again = input("Переназначить? [нет/да]: ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            return 0
        if again not in ("да", "y", "yes", "д"):
            return 0

    say("")
    say("Постановка компьютера на учёт в системе «Компьютеры».")
    say("Сайт: %s" % API)
    say("")

    while True:
        corpus = ask_number("Номер корпуса", 1, 99)
        if corpus is None:
            say("Отменено.")
            return 1
        room = ask_number("Номер аудитории", 1, 9999)
        if room is None:
            say("Отменено.")
            return 1
        number = ask_number("Номер компьютера в аудитории", 1, 999)
        if number is None:
            say("Отменено.")
            return 1

        name = "%dk-%d-%d" % (corpus, room, number)

        try:
            busy = call("/api/computers/device/taken", None,
                        {"corpus": corpus, "room": room, "number": number})
        except (urllib.error.URLError, urllib.error.HTTPError, OSError, ValueError) as error:
            say("Сайт не ответил: %s" % error)
            return 1

        if busy.get("taken") and busy.get("hostname") != socket.gethostname():
            say("")
            say("Место %s уже занято машиной %s." % (name, busy.get("hostname") or "с другим именем"))
            say("Выберите другой номер.")
            say("")
            continue

        say("")
        say("Этот компьютер будет называться %s." % name)
        try:
            yes = input("Верно? [да/нет]: ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            return 1
        if yes in ("да", "y", "yes", "д", ""):
            break
        say("")

    try:
        created = call("/api/computers/device/enroll", {
            "corpus": corpus,
            "room": room,
            "number": number,
            "hostname": socket.gethostname(),
            "fingerprint": key.get("fingerprint", ""),
            "secret": key.get("secret", ""),
            "computer": name,
        })
    except urllib.error.HTTPError as error:
        body = error.read().decode("utf-8", "replace")
        say("Сайт отказал: %s %s" % (error.code, body[:300]))
        return 1
    except (urllib.error.URLError, OSError, ValueError) as error:
        say("Сайт не ответил: %s" % error)
        return 1

    write_secret(PROXY_SECRET_FILE, created.get("proxy_secret", ""))
    write_secret(COMMAND_SECRET_FILE, created.get("command_secret", ""))
    write_secret(SCREEN_SECRET_FILE, created.get("screen_secret", ""))
    write_secret(VAULT_SECRET_FILE, created.get("vault_secret", ""))

    write_config({
        "DE_COMPUTER_ID": created.get("computer", name),
        "DE_COMPUTER_CORPUS": str(corpus),
        "DE_COMPUTER_ROOM": str(room),
        "DE_COMPUTER_NUMBER": str(number),
        "DE_API_URL": API,
        "DE_SCREEN_URL": created.get("screen_url", "https://as.1580.ru/screens"),
    })

    policy = created.get("policy")
    if policy:
        os.makedirs("/run/digital-examen", exist_ok=True)
        out = open(CONFIG.get("DE_POLICY_FILE", "/run/digital-examen/policy.json"), "w")
        out.write(json.dumps(policy))
        out.close()

    say("Беру выгрузку учёток для входа без интернета.")
    code = subprocess.call(["/usr/local/sbin/de-vault", "sync"])
    if code != 0:
        say("Выгрузка не получена, вход без интернета пока не работает.")
        say("Проверить потом: de-vault sync, затем de-vault show.")

    say("")
    say("Готово. Компьютер зарегистрирован как %s." % created.get("computer", name))
    return 0


sys.exit(main())
