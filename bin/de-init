#!/usr/bin/python3

import json
import os
import socket
import ssl
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

sys.path.insert(0, "/usr/local/lib/digital-examen")

import de_common
import de_keys

API = de_common.setting("DE_API_URL", "https://ex.1580.ru")
KEY_NAME = "de-key.txt"
POLICY_FILE = os.path.join(de_common.STATE_DIR, "policy.json")


def say(message):
    sys.stdout.write(message + "\n")
    sys.stdout.flush()


def call(path, payload=None, params=None):
    url = API.rstrip("/") + path
    if params:
        url = url + "?" + urllib.parse.urlencode(params)
    data = json.dumps(payload).encode() if payload is not None else None
    request = urllib.request.Request(url, data=data)
    if data is not None:
        request.add_header("Content-Type", "application/json")
    answer = urllib.request.urlopen(request, timeout=25, context=ssl.create_default_context())
    return json.loads(answer.read().decode("utf-8"))


def fetch_public_key():
    if os.path.exists(de_keys.PUBLIC_KEY_FILE):
        return
    try:
        pem = call("/api/computers/key/public").get("public_key", "")
    except (OSError, ValueError):
        return
    if pem:
        de_common.write_file(de_keys.PUBLIC_KEY_FILE, pem)


def read_key():
    asked = False
    while True:
        path = de_keys.find_key(KEY_NAME)
        if path:
            values = de_keys.parse_key(path)
            if values.get("token") and values.get("verified"):
                say("Ключ прочитан, владелец: %s" % values.get("login", ""))
                return values
            if values.get("token") and not os.path.exists(de_keys.PUBLIC_KEY_FILE):
                say("Ключ прочитан, подпись проверит сайт")
                return values
            say("Ключ на флешке не подходит, скачайте его на сайте заново")
            return {}
        if not asked:
            say("Вставьте флешку с файлом %s (Компьютеры - Скачать ключ). Отмена - Ctrl+C" % KEY_NAME)
            asked = True
        try:
            time.sleep(2)
        except KeyboardInterrupt:
            return {}


def ask_number(question, low, high):
    while True:
        try:
            raw = input(question + ": ").strip()
        except (EOFError, KeyboardInterrupt):
            return None
        if raw.isdigit() and low <= int(raw) <= high:
            return int(raw)
        say("Нужно число от %d до %d" % (low, high))


def write_config(values):
    lines = []
    seen = set()
    for line in open(de_common.CONFIG_FILE):
        key = line.split("=", 1)[0].strip()
        if key in values:
            lines.append('%s="%s"\n' % (key, values[key]))
            seen.add(key)
        else:
            lines.append(line)
    for key, value in values.items():
        if key not in seen:
            lines.append('%s="%s"\n' % (key, value))
    de_common.write_file(de_common.CONFIG_FILE, "".join(lines), 0o640)


def choose_place():
    while True:
        corpus = ask_number("Номер корпуса", 1, 99)
        room = ask_number("Номер аудитории", 1, 9999) if corpus else None
        number = ask_number("Номер компьютера в аудитории", 1, 999) if room else None
        if number is None:
            return None
        name = "%dk-%d-%d" % (corpus, room, number)
        try:
            busy = call("/api/computers/device/taken", None,
                        {"corpus": corpus, "room": room, "number": number})
        except (OSError, ValueError) as error:
            say("Сайт не ответил: %s" % error)
            return None
        if busy.get("taken") and busy.get("hostname") != socket.gethostname():
            say("Место %s уже занято машиной %s, выберите другой номер" % (name, busy.get("hostname") or "с другим именем"))
            continue
        try:
            yes = input("Компьютер будет называться %s. Верно? [да/нет]: " % name).strip().lower()
        except (EOFError, KeyboardInterrupt):
            return None
        if yes in ("да", "д", "y", "yes", ""):
            return corpus, room, number, name


def main():
    if os.geteuid() != 0:
        say("Запускать от root")
        return 1
    if not os.path.exists(de_common.CONFIG_FILE):
        say("Нет %s, сначала setup.sh" % de_common.CONFIG_FILE)
        return 1

    fetch_public_key()
    key = read_key()
    if not key:
        say("Ключ не предъявлен, установка прервана")
        return 1

    existing = de_common.computer()
    if existing:
        try:
            again = input("Компьютер уже на учёте как %s. Переназначить? [нет/да]: " % existing).strip().lower()
        except (EOFError, KeyboardInterrupt):
            return 0
        if again not in ("да", "д", "y", "yes"):
            return 0

    say("Постановка на учёт, сайт %s" % API)
    place = choose_place()
    if place is None:
        say("Отменено")
        return 1
    corpus, room, number, name = place

    try:
        created = call("/api/computers/device/enroll", {
            "corpus": corpus,
            "room": room,
            "number": number,
            "hostname": socket.gethostname(),
            "token": key.get("token", ""),
            "computer": name,
        })
    except urllib.error.HTTPError as error:
        say("Сайт отказал: %s %s" % (error.code, error.read().decode("utf-8", "replace")[:300]))
        return 1
    except (OSError, ValueError) as error:
        say("Сайт не ответил: %s" % error)
        return 1

    for kind in ("proxy", "command", "screen"):
        value = created.get(kind + "_secret", "")
        if value:
            de_common.write_file("/etc/digital-examen/%s.secret" % kind, value + "\n", 0o600)

    write_config({
        "DE_COMPUTER_ID": created.get("computer", name),
        "DE_COMPUTER_CORPUS": str(corpus),
        "DE_COMPUTER_ROOM": str(room),
        "DE_COMPUTER_NUMBER": str(number),
        "DE_API_URL": API,
        "DE_SCREEN_URL": created.get("screen_url", "https://ex.1580.ru/screens"),
    })

    if created.get("policy"):
        de_common.write_file(POLICY_FILE, json.dumps(created["policy"], sort_keys=True))

    say("Готово, компьютер на учёте как %s" % created.get("computer", name))
    return 0


sys.exit(main())
