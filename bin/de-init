#!/usr/bin/python3

import json
import os
import socket
import ssl
import sys
import time
import urllib.error
import urllib.request

CONFIG_FILE = "/etc/digital-examen/computers.conf"
KEY_NAME = "de-key.txt"
MEDIA_DIRS = ("/run/media", "/media", "/mnt")


def read_config():
    values = {}
    if not os.path.exists(CONFIG_FILE):
        return values
    data = open(CONFIG_FILE)
    for line in data:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        name, value = line.split("=", 1)
        value = value.strip()
        if len(value) > 1 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        values[name.strip()] = value
    data.close()
    return values


CONFIG = read_config()
API = CONFIG.get("DE_API_URL", "")
SECRET_FILE = CONFIG.get("DE_PROXY_SECRET_FILE", "/etc/digital-examen/proxy.secret")


def build_opener():
    ca = CONFIG.get("DE_SCREEN_CA", "")
    if not ca or not os.path.exists(ca):
        return urllib.request.build_opener()
    context = ssl.create_default_context(cafile=ca)
    context.check_hostname = True
    context.verify_mode = ssl.CERT_REQUIRED
    return urllib.request.build_opener(urllib.request.HTTPSHandler(context=context))


OPENER = build_opener()


def say(message):
    sys.stdout.write(message + "\n")
    sys.stdout.flush()


def read_secret():
    if not os.path.exists(SECRET_FILE):
        return ""
    return open(SECRET_FILE).read().strip()


def find_key():
    for base in MEDIA_DIRS:
        if not os.path.isdir(base):
            continue
        for first in sorted(os.listdir(base)):
            top = os.path.join(base, first)
            candidate = os.path.join(top, KEY_NAME)
            if os.path.isfile(candidate):
                return candidate
            if not os.path.isdir(top):
                continue
            for second in sorted(os.listdir(top)):
                candidate = os.path.join(top, second, KEY_NAME)
                if os.path.isfile(candidate):
                    return candidate
    return ""


def parse_key(path):
    values = {}
    for line in open(path):
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        name, value = line.split("=", 1)
        values[name.strip()] = value.strip()
    return values


def wait_for_key():
    said = False
    while True:
        path = find_key()
        if path:
            return parse_key(path)
        if not said:
            say("Вставьте флешку с ключом (файл %s в корне) и подождите." % KEY_NAME)
            say("Прервать — Ctrl+C.")
            said = True
        time.sleep(3)


def post(path, payload):
    body = json.dumps(payload).encode()
    request = urllib.request.Request(API.rstrip("/") + path, data=body)
    request.add_header("Content-Type", "application/json")
    request.add_header("X-De-Secret", read_secret())
    answer = OPENER.open(request, timeout=25)
    return json.loads(answer.read().decode("utf-8"))


def ask_number(question, low, high):
    while True:
        try:
            raw = input(question + ": ").strip()
        except EOFError:
            return None
        if not raw.isdigit():
            say("Нужно число от %d до %d." % (low, high))
            continue
        value = int(raw)
        if value < low or value > high:
            say("Нужно число от %d до %d." % (low, high))
            continue
        return value


def write_config(name, room, corpus, number):
    lines = []
    seen = set()
    wanted = {
        "DE_COMPUTER_ID": name,
        "DE_COMPUTER_CORPUS": str(corpus),
        "DE_COMPUTER_ROOM": str(room),
        "DE_COMPUTER_NUMBER": str(number),
    }

    for line in open(CONFIG_FILE):
        key = line.split("=", 1)[0].strip()
        if key in wanted:
            lines.append('%s="%s"\n' % (key, wanted[key]))
            seen.add(key)
        else:
            lines.append(line)

    for key, value in wanted.items():
        if key not in seen:
            lines.append('%s="%s"\n' % (key, value))

    out = open(CONFIG_FILE, "w")
    out.write("".join(lines))
    out.close()
    os.chmod(CONFIG_FILE, 0o640)


def main():
    if not API:
        say("В конфиге не указан DE_API_URL — впишите адрес сайта и повторите.")
        return 1
    if not read_secret():
        say("Нет общего секрета в %s — впишите его и повторите." % SECRET_FILE)
        return 1

    if CONFIG.get("DE_COMPUTER_ID"):
        say("Компьютер уже назван %s." % CONFIG["DE_COMPUTER_ID"])
        try:
            again = input("Переназначить? [нет/да]: ").strip().lower()
        except EOFError:
            return 0
        if again not in ("да", "y", "yes"):
            return 0

    key = wait_for_key()
    if not key.get("fingerprint") or not key.get("secret"):
        say("Файл ключа не читается: нет fingerprint или secret.")
        return 1

    try:
        answer = post("/api/computers/device/key-check", {
            "fingerprint": key["fingerprint"],
            "secret": key["secret"],
        })
    except (urllib.error.URLError, urllib.error.HTTPError, OSError, ValueError) as error:
        say("Сайт не ответил: %s" % error)
        return 1

    if not answer.get("ok"):
        say("Ключ не принят: %s" % answer.get("reason", "неизвестная причина"))
        return 1
    if not answer.get("can_init"):
        say("Ключ действителен, но инициализировать компьютеры им нельзя: %s"
            % answer.get("reason", "нет прав"))
        return 1

    say("Ключ принят, владелец: %s" % answer.get("name", answer.get("login", "")))

    corpus = ask_number("Номер корпуса", 1, 99)
    room = ask_number("Номер аудитории", 1, 9999)
    number = ask_number("Номер компьютера", 1, 999)
    if corpus is None or room is None or number is None:
        say("Отменено.")
        return 1

    try:
        created = post("/api/computers/device/register", {
            "fingerprint": key["fingerprint"],
            "secret": key["secret"],
            "corpus": corpus,
            "room": room,
            "number": number,
            "hostname": socket.gethostname(),
        })
    except (urllib.error.URLError, urllib.error.HTTPError, OSError, ValueError) as error:
        say("Зарегистрировать не удалось: %s" % error)
        return 1

    name = created.get("computer", "")
    if not name:
        say("Сайт не вернул имя компьютера.")
        return 1

    write_config(name, room, corpus, number)
    say("Компьютер зарегистрирован как %s." % name)
    say("Выньте флешку и перезагрузите компьютер.")
    return 0


sys.exit(main())
