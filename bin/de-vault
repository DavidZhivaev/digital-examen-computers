#!/usr/bin/python3

import json
import os
import ssl
import sys
import time
import urllib.error
import urllib.request

sys.path.insert(0, "/usr/local/lib/digital-examen")

import de_vault

CONFIG = de_vault.read_config()
API = CONFIG.get("DE_API_URL", "")
COMPUTER = CONFIG.get("DE_COMPUTER_ID", "")
PROXY_SECRET_FILE = CONFIG.get("DE_PROXY_SECRET_FILE", "/etc/digital-examen/proxy.secret")
VAULT_SECRET_FILE = CONFIG.get("DE_VAULT_SECRET_FILE", "/etc/digital-examen/vault.secret")
VAULT_DIR = CONFIG.get("DE_VAULT_DIR", "/var/lib/digital-examen/vault")
BUNDLE_FILE = os.path.join(VAULT_DIR, "bundle.de")
ATTEMPT_FILE = os.path.join(VAULT_DIR, "attempts.json")
MAX_AGE_DAYS = int(CONFIG.get("DE_VAULT_MAX_AGE_DAYS", "30"))
MAX_TRIES = int(CONFIG.get("DE_VAULT_MAX_TRIES", "10"))
LOCK_MINUTES = int(CONFIG.get("DE_VAULT_LOCK_MINUTES", "30"))
LOG = CONFIG.get("DE_LOG_FILE", "/var/log/digital-examen-computers.log")
TIMEOUT = int(CONFIG.get("DE_API_TIMEOUT", "10"))


def log(message):
    stamp = time.strftime("%Y-%m-%d %H:%M:%S")
    try:
        out = open(LOG, "a")
        out.write(stamp + " de-vault " + message + "\n")
        out.close()
    except IOError:
        pass


def build_opener():
    ca = CONFIG.get("DE_SCREEN_CA", "")
    if not ca or not os.path.exists(ca):
        return urllib.request.build_opener()
    context = ssl.create_default_context(cafile=ca)
    context.check_hostname = True
    context.verify_mode = ssl.CERT_REQUIRED
    return urllib.request.build_opener(urllib.request.HTTPSHandler(context=context))


OPENER = build_opener()


def vault_secret():
    return de_vault.read_text(VAULT_SECRET_FILE)


def call(path, payload):
    url = API.rstrip("/") + path
    request = urllib.request.Request(url, data=json.dumps(payload).encode())
    request.add_header("Content-Type", "application/json")
    request.add_header("X-De-Computer", COMPUTER)
    request.add_header("X-De-Secret", de_vault.read_text(PROXY_SECRET_FILE))
    answer = OPENER.open(request, timeout=max(TIMEOUT, 60))
    return answer.read().decode("utf-8")


def read_password():
    data = sys.stdin.buffer.read()
    if data.endswith(b"\x00"):
        data = data[:-1]
    return data.decode("utf-8", "replace").rstrip("\n")


def load_attempts():
    text = de_vault.read_text(ATTEMPT_FILE)
    if not text:
        return {}
    try:
        return json.loads(text)
    except ValueError:
        return {}


def save_attempts(values):
    de_vault.write_private(ATTEMPT_FILE, json.dumps(values))


def locked(login):
    values = load_attempts()
    edge = time.time() - LOCK_MINUTES * 60
    tries = [item for item in values.get(login, []) if item > edge]
    return len(tries) >= MAX_TRIES


def note_failure(login):
    values = load_attempts()
    edge = time.time() - LOCK_MINUTES * 60
    tries = [item for item in values.get(login, []) if item > edge]
    tries.append(time.time())
    values[login] = tries
    save_attempts(values)


def clear_failures(login):
    values = load_attempts()
    if login in values:
        values.pop(login)
        save_attempts(values)


def sync():
    """Забрать изменения выгрузки и приложить их к своей копии."""
    secret = vault_secret()
    if not secret or not API or not COMPUTER:
        log("нет секрета или имени компьютера, выгрузка не забирается")
        return 1

    bundle = de_vault.load_bundle(BUNDLE_FILE, secret)
    since = int(bundle.get("since", 0)) if bundle else 0

    rounds = 0
    while rounds < 20:
        rounds += 1
        try:
            blob = call("/api/computers/device/offline/bundle",
                        {"computer": COMPUTER, "since": since})
        except (urllib.error.URLError, urllib.error.HTTPError, OSError, ValueError) as error:
            log("выгрузка не получена: " + str(error))
            return 1

        part = de_vault.unseal(secret, blob)
        if part is None:
            log("выгрузка не прошла проверку подписи")
            return 1

        bundle = de_vault.merge(bundle, part)
        de_vault.write_private(BUNDLE_FILE, de_vault.seal(secret, bundle))

        if not part.get("more"):
            break
        since = bundle.get("since", since)

    log("выгрузка обновлена, учёток %d" % len(bundle.get("accounts", [])))
    return 0


def check(login, password):
    secret = vault_secret()
    if not secret:
        return 1

    login = login.lower()
    if locked(login):
        log("офлайн-вход закрыт на %d минут: %s" % (LOCK_MINUTES, login))
        return 1

    bundle = de_vault.load_bundle(BUNDLE_FILE, secret)
    if not de_vault.bundle_fresh(bundle, MAX_AGE_DAYS):
        log("выгрузка устарела или отсутствует")
        return 1

    entry = de_vault.find_entry(bundle, login)
    if entry is None:
        note_failure(login)
        return 1

    if not de_vault.password_matches(secret, entry, password):
        note_failure(login)
        return 1

    clear_failures(login)
    sys.stdout.write(json.dumps({
        "login": login,
        "role": entry.get("role", ""),
        "informatics": entry.get("informatics", ""),
        "scope": entry.get("scope", ""),
        "user_id": entry.get("user_id", ""),
        "made": bundle.get("made", 0),
    }) + "\n")
    return 0


def show():
    secret = vault_secret()
    bundle = de_vault.load_bundle(BUNDLE_FILE, secret)
    accounts = bundle.get("accounts", []) if bundle else []
    students = len([item for item in accounts if item.get("scope") == "student"])
    sys.stdout.write(json.dumps({
        "secret": bool(secret),
        "accounts": len(accounts),
        "students": students,
        "teachers": len(accounts) - students,
        "made": bundle.get("made", 0) if bundle else 0,
        "fresh": de_vault.bundle_fresh(bundle, MAX_AGE_DAYS),
        "max_age_days": MAX_AGE_DAYS,
    }, ensure_ascii=False) + "\n")
    return 0


def main():
    if len(sys.argv) < 2:
        sys.stderr.write("usage: de-vault <sync|check LOGIN|show>\n")
        return 2

    os.makedirs(VAULT_DIR, exist_ok=True)
    os.chmod(VAULT_DIR, 0o700)

    action = sys.argv[1]
    if action == "sync":
        return sync()
    if action == "show":
        return show()
    if action == "check" and len(sys.argv) >= 3:
        password = read_password()
        if not password:
            return 1
        return check(sys.argv[2], password)

    sys.stderr.write("usage: de-vault <sync|check LOGIN|show>\n")
    return 2


sys.exit(main())
