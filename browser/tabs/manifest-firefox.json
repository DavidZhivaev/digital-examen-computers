{
  "manifest_version": 3,
  "name": "Digital Examen — вкладки",
  "version": "1.3.0",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "scripting",
    "alarms",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": ["*://*/*"],
  "background": {
    "scripts": [
      "tabs.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tabs@digital-examen.local",
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "exclude_matches": ["*://*.1580.ru/*", "*://*.silvertests.ru/*"],
      "js": ["cosmetic.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.google.com/*",
        "*://*.google.ru/*",
        "*://*.google.co.uk/*",
        "*://*.google.de/*",
        "*://*.google.fr/*",
        "*://*.google.com.tr/*",
        "*://*.google.kz/*",
        "*://*.google.by/*",
        "*://*.google.ca/*",
        "*://*.google.com.au/*"
      ],
      "js": [
        "search.js"
      ],
      "run_at": "document_start"
    }
  ],
  "incognito": "spanning"
}
