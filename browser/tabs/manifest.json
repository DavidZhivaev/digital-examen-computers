{
  "manifest_version": 3,
  "name": "Digital Examen — вкладки",
  "version": "1.3.1",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "scripting",
    "alarms",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "tabs.js"
  },
  "key": "",
  "update_url": "https://ex.1580.ru/browser-tabs/update.xml",
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "exclude_matches": ["*://*.1580.ru/*"],
      "js": ["cosmetic.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.google.com/*",
        "*://*.google.ru/*",
        "*://*.google.co.uk/*",
        "*://*.google.de/*",
        "*://*.google.fr/*",
        "*://*.google.com.tr/*",
        "*://*.google.kz/*",
        "*://*.google.by/*",
        "*://*.google.ca/*",
        "*://*.google.com.au/*"
      ],
      "js": [
        "search.js"
      ],
      "run_at": "document_start"
    }
  ],
  "incognito": "spanning"
}
