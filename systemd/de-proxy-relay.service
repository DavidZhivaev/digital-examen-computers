[Unit]
Description=Digital Examen proxy relay for student namespace
After=de-netns.service
Requires=de-netns.service
Before=sddm.service

[Service]
ExecStart=/usr/local/sbin/de-proxy-relay
Restart=always
RestartSec=2
User=root
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
