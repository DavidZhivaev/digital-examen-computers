#!/usr/bin/python3

import os
import sys
import time

POLICY_DIR = os.environ.get("DE_POLICY_DIR", "/etc/squid/policy")
RELOAD_SECONDS = 20

CACHE = {"loaded_at": 0, "classes": {}, "logins": {}, "school": []}


def read_lines(path):
    if not os.path.exists(path):
        return []
    out = []
    for line in open(path):
        line = line.strip()
        if line and not line.startswith("#"):
            out.append(line)
    return out


def load():
    now = time.time()
    if now - CACHE["loaded_at"] < RELOAD_SECONDS:
        return
    CACHE["loaded_at"] = now
    CACHE["school"] = read_lines(os.path.join(POLICY_DIR, "school-allow.txt"))

    logins = {}
    for line in read_lines(os.path.join(POLICY_DIR, "login-class.txt")):
        parts = line.split()
        if len(parts) == 2:
            logins[parts[0].lower()] = parts[1]
    CACHE["logins"] = logins

    classes = {}
    for name in os.listdir(POLICY_DIR) if os.path.isdir(POLICY_DIR) else []:
        if not name.startswith("class-") or not name.endswith(".txt"):
            continue
        class_id = name[len("class-"):-len(".txt")]
        lines = read_lines(os.path.join(POLICY_DIR, name))
        mode = "deny"
        domains = []
        for line in lines:
            if line.startswith("mode "):
                mode = line.split(None, 1)[1].strip()
                continue
            domains.append(line)
        classes[class_id] = (mode, domains)
    CACHE["classes"] = classes


def matches(host, pattern):
    host = host.lower().strip(".")
    pattern = pattern.lower().strip()
    if pattern.startswith("."):
        bare = pattern[1:]
        return host == bare or host.endswith("." + bare)
    return host == pattern


def in_list(host, patterns):
    for pattern in patterns:
        if matches(host, pattern):
            return True
    return False


def decide(login, host):
    load()

    if not in_list(host, CACHE["school"]):
        return False

    class_id = CACHE["logins"].get(login.lower())
    if class_id is None:
        return True

    rule = CACHE["classes"].get(class_id)
    if rule is None:
        return True

    mode, domains = rule
    if mode == "allow":
        return in_list(host, domains)
    return not in_list(host, domains)


for line in sys.stdin:
    parts = line.strip().split(" ")
    if len(parts) < 2:
        sys.stdout.write("ERR\n")
        sys.stdout.flush()
        continue
    login = parts[0]
    host = parts[1].split(":")[0]
    if decide(login, host):
        sys.stdout.write("OK\n")
    else:
        sys.stdout.write("ERR\n")
    sys.stdout.flush()
